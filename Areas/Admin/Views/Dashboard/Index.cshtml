@model AdminDashboardViewModel
@using System.Globalization
@functions {
    private static string F(double value) => value.ToString("0.##", CultureInfo.InvariantCulture);

    private static string F(decimal value) => value.ToString("0.##", CultureInfo.InvariantCulture);

    private static string GrowthClass(double value) => value >= 0 ? "is-up" : "is-down";

    private static string GrowthLabel(double value) =>
        $"{(value >= 0 ? "+" : string.Empty)}{value.ToString("0.#", CultureInfo.InvariantCulture)} %";
}
@{
    ViewData["Title"] = "Tableau de bord";

    var monthly = Model.MonthlyRevenue;
    var chartMax = monthly.Count == 0 ? 1m : Math.Max(1m, monthly.Max(point => point.Amount));
    const double chartWidth = 720;
    const double chartHeight = 240;
    const double padX = 34;
    const double padTop = 18;
    const double padBottom = 34;
    var plotHeight = chartHeight - padTop - padBottom;
    var stepX = monthly.Count > 1 ? (chartWidth - padX * 2) / (monthly.Count - 1) : 0;

    var points = monthly
        .Select((point, index) => new
        {
            point.Label,
            point.Amount,
            point.IsCurrent,
            X = padX + index * stepX,
            Y = padTop + plotHeight * (1 - (double)(point.Amount / chartMax))
        })
        .ToList();

    var linePath = points.Count == 0
        ? string.Empty
        : "M " + string.Join(" L ", points.Select(point => $"{F(point.X)} {F(point.Y)}"));

    var areaPath = points.Count == 0
        ? string.Empty
        : $"{linePath} L {F(points.Last().X)} {F(padTop + plotHeight)} L {F(points.First().X)} {F(padTop + plotHeight)} Z";

    var statusTotal = Model.OrdersByStatus.Sum(item => item.Count);
    var segments = new List<string>();
    var cursor = 0d;

    foreach (var item in Model.OrdersByStatus)
    {
        var start = cursor;
        var end = statusTotal == 0 ? 0 : cursor + item.Count * 100d / statusTotal;

        if (item.Count > 0)
        {
            segments.Add($"{item.Color} {F(start)}% {F(end)}%");
        }

        cursor = end;
    }

    var donutGradient = segments.Count == 0
        ? "#e2e8f0 0% 100%"
        : string.Join(", ", segments);

    var maxProductRevenue = Model.TopProducts.Count == 0
        ? 1m
        : Math.Max(1m, Model.TopProducts.Max(item => item.Revenue));

    var maxCategoryRevenue = Model.SalesByCategory.Count == 0
        ? 1m
        : Math.Max(1m, Model.SalesByCategory.Max(item => item.Revenue));

    var maxCustomerSpent = Model.TopCustomers.Count == 0
        ? 1m
        : Math.Max(1m, Model.TopCustomers.Max(item => item.TotalSpent));
}

<section class="adm-kpi-grid">
    <article class="adm-kpi is-primary">
        <span class="adm-kpi-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M4 19V9M9.3 19V5M14.6 19v-7M20 19V7" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            </svg>
        </span>
        <span class="adm-kpi-label">Chiffre d'affaires</span>
        <strong class="adm-kpi-value">@Model.TotalRevenue.ToString("N2") €</strong>
        <span class="adm-kpi-meta">
            <span class="adm-trend @GrowthClass(Model.RevenueGrowthPercent)">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M6 15l6-6 6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                @GrowthLabel(Model.RevenueGrowthPercent)
            </span>
            vs mois dernier
        </span>
    </article>

    <article class="adm-kpi">
        <span class="adm-kpi-icon is-green">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <rect x="3.5" y="5.5" width="17" height="14" rx="3" stroke="currentColor" stroke-width="1.9" />
                <path d="M3.5 10h17M7 15h4" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" />
            </svg>
        </span>
        <span class="adm-kpi-label">Revenu du mois</span>
        <strong class="adm-kpi-value">@Model.RevenueThisMonth.ToString("N2") €</strong>
        <span class="adm-kpi-meta">@Model.OrdersThisMonth commande(s) ce mois-ci</span>
    </article>

    <article class="adm-kpi">
        <span class="adm-kpi-icon is-amber">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M7 3h10l3 4v13H4V7l3-4Z" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round" />
                <path d="M4 7h16M9 11.5h6M9 15.5h4" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" />
            </svg>
        </span>
        <span class="adm-kpi-label">Commandes</span>
        <strong class="adm-kpi-value">@Model.TotalOrders</strong>
        <span class="adm-kpi-meta">
            <span class="adm-trend @GrowthClass(Model.OrdersGrowthPercent)">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M6 15l6-6 6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                @GrowthLabel(Model.OrdersGrowthPercent)
            </span>
            ce mois : @Model.OrdersThisMonth
        </span>
    </article>

    <article class="adm-kpi">
        <span class="adm-kpi-icon is-violet">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M6 8h12l-1 12H7L6 8Z" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round" />
                <path d="M9 8V6a3 3 0 0 1 6 0v2" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" />
            </svg>
        </span>
        <span class="adm-kpi-label">Panier moyen</span>
        <strong class="adm-kpi-value">@Model.AverageOrderValue.ToString("N2") €</strong>
        <span class="adm-kpi-meta">@Model.ActiveCustomersThisMonth client(s) actif(s) ce mois</span>
    </article>
</section>

<section class="adm-mini-grid">
    <article class="adm-mini">
        <span class="adm-mini-label">Clients inscrits</span>
        <strong class="adm-mini-value">@Model.TotalCustomers</strong>
    </article>
    <article class="adm-mini">
        <span class="adm-mini-label">Produits en catalogue</span>
        <strong class="adm-mini-value">@Model.TotalProducts</strong>
    </article>
    <article class="adm-mini">
        <span class="adm-mini-label">Stock faible</span>
        <strong class="adm-mini-value is-amber">@Model.LowStockCount</strong>
    </article>
    <article class="adm-mini">
        <span class="adm-mini-label">Ruptures de stock</span>
        <strong class="adm-mini-value is-red">@Model.OutOfStockCount</strong>
    </article>
    <article class="adm-mini">
        <span class="adm-mini-label">Paiements en attente</span>
        <strong class="adm-mini-value is-amber">@Model.PendingPayments</strong>
    </article>
    <article class="adm-mini">
        <span class="adm-mini-label">Commandes livrées</span>
        <strong class="adm-mini-value is-green">@Model.DeliveredOrders</strong>
    </article>
</section>

<section class="adm-grid is-main">
    <article class="adm-card">
        <header class="adm-card-head">
            <div>
                <h2 class="adm-card-title">Évolution du chiffre d'affaires</h2>
                <p class="adm-card-sub">12 derniers mois · commandes hors annulations</p>
            </div>
            <span class="adm-card-pill">@Model.TotalRevenue.ToString("N2") € cumulés</span>
        </header>

        <div class="adm-linechart-wrap">
            <svg class="adm-linechart" viewBox="0 0 720 240" role="img"
                 aria-label="Évolution du chiffre d'affaires sur les 12 derniers mois">
                <defs>
                    <linearGradient id="admAreaGradient" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="#2563eb" stop-opacity="0.30" />
                        <stop offset="100%" stop-color="#2563eb" stop-opacity="0" />
                    </linearGradient>
                </defs>

                @for (var grid = 0; grid <= 4; grid++)
                {
                    var gridY = padTop + plotHeight * grid / 4;
                    var gridValue = chartMax * (4 - grid) / 4;

                    <line x1="@F(padX)" y1="@F(gridY)" x2="@F(chartWidth - padX)" y2="@F(gridY)"
                          stroke="#e2e8f0" stroke-width="1" stroke-dasharray="4 5" />
                    @Html.Raw($"<text x=\"0\" y=\"{F(gridY + 3)}\" fill=\"#94a3b8\" font-size=\"10\">{gridValue.ToString("N0", CultureInfo.InvariantCulture)}</text>")
                }

                @if (points.Count > 0)
                {
                    <path d="@areaPath" fill="url(#admAreaGradient)" />
                    <path d="@linePath" fill="none" stroke="#2563eb" stroke-width="2.6"
                          stroke-linejoin="round" stroke-linecap="round" />

                    @foreach (var point in points)
                    {
                        <circle cx="@F(point.X)" cy="@F(point.Y)" r="@(point.IsCurrent ? "4.6" : "3.2")"
                                fill="#fff" stroke="#2563eb" stroke-width="2">
                            <title>@point.Label : @point.Amount.ToString("N2") €</title>
                        </circle>
                    }
                }
            </svg>

            <div class="adm-chart-x">
                @foreach (var point in monthly)
                {
                    <span class="@(point.IsCurrent ? "is-current" : null)">@point.Label</span>
                }
            </div>
        </div>
    </article>

    <article class="adm-card">
        <header class="adm-card-head">
            <div>
                <h2 class="adm-card-title">Répartition des commandes</h2>
                <p class="adm-card-sub">Par statut de traitement</p>
            </div>
        </header>

        <div class="adm-donut-wrap">
            <div class="adm-donut" style="background: conic-gradient(@donutGradient);">
                <div class="adm-donut-hole">
                    <strong>@statusTotal</strong>
                    <span>commandes</span>
                </div>
            </div>

            <ul class="adm-legend">
                @foreach (var item in Model.OrdersByStatus)
                {
                    <li>
                        <span class="adm-legend-dot" style="background: @item.Color;"></span>
                        <span class="adm-legend-label">@item.Label</span>
                        <span class="adm-legend-value">@item.Count</span>
                        <span class="adm-legend-percent">@item.Percentage.ToString("0.#", CultureInfo.InvariantCulture) %</span>
                    </li>
                }
            </ul>
        </div>
    </article>
</section>

<section class="adm-grid is-three">
    <article class="adm-card">
        <header class="adm-card-head">
            <div>
                <h2 class="adm-card-title">Meilleures ventes</h2>
                <p class="adm-card-sub">Top produits par chiffre d'affaires</p>
            </div>
        </header>

        @if (Model.TopProducts.Count == 0)
        {
            <p class="adm-empty-inline">Aucune vente enregistrée pour le moment.</p>
        }
        else
        {
            <ul class="adm-bar-list">
                @foreach (var product in Model.TopProducts)
                {
                    var width = (double)(product.Revenue / maxProductRevenue) * 100;

                    <li class="adm-bar-row">
                        <div class="adm-bar-head">
                            <span class="adm-bar-name">@product.Name</span>
                            <span class="adm-bar-value">@product.Revenue.ToString("N2") €</span>
                        </div>
                        <div class="adm-bar-track">
                            <span class="adm-bar-fill" style="width: @F(width)%;"></span>
                        </div>
                        <div class="adm-bar-foot">
                            <span>@product.UnitsSold unité(s)</span>
                            <span>Stock : @product.Stock</span>
                        </div>
                    </li>
                }
            </ul>
        }
    </article>

    <article class="adm-card">
        <header class="adm-card-head">
            <div>
                <h2 class="adm-card-title">Ventes par catégorie</h2>
                <p class="adm-card-sub">Répartition du chiffre d'affaires</p>
            </div>
        </header>

        @if (Model.SalesByCategory.Count == 0)
        {
            <p class="adm-empty-inline">Aucune vente enregistrée pour le moment.</p>
        }
        else
        {
            <ul class="adm-bar-list">
                @foreach (var category in Model.SalesByCategory)
                {
                    var width = (double)(category.Revenue / maxCategoryRevenue) * 100;

                    <li class="adm-bar-row">
                        <div class="adm-bar-head">
                            <span class="adm-bar-name">@category.Name</span>
                            <span class="adm-bar-value">@category.Revenue.ToString("N2") €</span>
                        </div>
                        <div class="adm-bar-track">
                            <span class="adm-bar-fill is-violet" style="width: @F(width)%;"></span>
                        </div>
                        <div class="adm-bar-foot">
                            <span>@category.UnitsSold unité(s)</span>
                            <span>@category.Share.ToString("0.#", CultureInfo.InvariantCulture) % du CA</span>
                        </div>
                    </li>
                }
            </ul>
        }
    </article>

    <article class="adm-card">
        <header class="adm-card-head">
            <div>
                <h2 class="adm-card-title">Paiements</h2>
                <p class="adm-card-sub">État des règlements</p>
            </div>
        </header>

        <ul class="adm-pay-list">
            @foreach (var payment in Model.PaymentsByStatus)
            {
                <li>
                    <span class="adm-pay-dot" style="background: @payment.Color;"></span>
                    <div class="adm-pay-copy">
                        <span class="adm-pay-label">@payment.Label</span>
                        <div class="adm-bar-track is-thin">
                            <span class="adm-bar-fill" style="width: @F(payment.Percentage)%; background: @payment.Color;"></span>
                        </div>
                    </div>
                    <span class="adm-pay-count">@payment.Count</span>
                </li>
            }
        </ul>

        <div class="adm-pay-note">
            <span>@Model.PendingOrders commande(s) à traiter</span>
            <span>@Model.CancelledOrders annulée(s)</span>
        </div>
    </article>
</section>

<section class="adm-grid is-main">
    <article class="adm-card">
        <header class="adm-card-head">
            <div>
                <h2 class="adm-card-title">Commandes récentes</h2>
                <p class="adm-card-sub">Les 6 dernières commandes</p>
            </div>
            <a class="adm-link" asp-area="Admin" asp-controller="Orders" asp-action="Index">
                Tout voir
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </a>
        </header>

        @if (Model.RecentOrders.Count == 0)
        {
            <p class="adm-empty-inline">Aucune commande pour le moment.</p>
        }
        else
        {
            <div class="adm-table-wrap">
                <table class="adm-table">
                    <thead>
                        <tr>
                            <th>Commande</th>
                            <th>Client</th>
                            <th>Date</th>
                            <th class="is-end">Montant</th>
                            <th>Statut</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model.RecentOrders)
                        {
                            <tr>
                                <td>
                                    <span class="adm-order-number">@order.OrderNumber</span>
                                    <span class="adm-order-meta">@order.ItemCount article(s)</span>
                                </td>
                                <td>
                                    <span class="adm-customer-name">@order.CustomerName</span>
                                    <span class="adm-order-meta">@order.CustomerEmail</span>
                                </td>
                                <td>@order.OrderDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="is-end">@order.TotalAmount.ToString("N2") €</td>
                                <td><span class="adm-badge @order.StatusBadgeClass">@order.StatusLabel</span></td>
                                <td class="is-end">
                                    <a class="adm-icon-btn" asp-area="Admin" asp-controller="Orders"
                                       asp-action="Details" asp-route-id="@order.Id" aria-label="Voir la commande @order.OrderNumber">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                            <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                        </svg>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </article>

    <div class="adm-stack">
        <article class="adm-card">
            <header class="adm-card-head">
                <div>
                    <h2 class="adm-card-title">Alertes stock</h2>
                    <p class="adm-card-sub">Produits à réapprovisionner</p>
                </div>
                <a class="adm-link" asp-area="Admin" asp-controller="Products" asp-action="Index">Gérer</a>
            </header>

            @if (Model.LowStockProducts.Count == 0)
            {
                <p class="adm-empty-inline">Tous les stocks sont à un niveau correct.</p>
            }
            else
            {
                <ul class="adm-stock-list">
                    @foreach (var product in Model.LowStockProducts)
                    {
                        <li>
                            <span class="adm-stock-thumb">
                                <img src="@product.ImageUrl" alt="" loading="lazy" />
                            </span>
                            <div class="adm-stock-copy">
                                <span class="adm-stock-name">@product.Name</span>
                                <span class="adm-order-meta">@product.CategoryName</span>
                            </div>
                            <span class="adm-badge @(product.Stock == 0 ? "is-cancelled" : "is-shipped")">
                                @(product.Stock == 0 ? "Rupture" : $"{product.Stock} restant(s)")
                            </span>
                        </li>
                    }
                </ul>
            }
        </article>

        <article class="adm-card">
            <header class="adm-card-head">
                <div>
                    <h2 class="adm-card-title">Meilleurs clients</h2>
                    <p class="adm-card-sub">Par montant total dépensé</p>
                </div>
            </header>

            @if (Model.TopCustomers.Count == 0)
            {
                <p class="adm-empty-inline">Aucun client avec commande.</p>
            }
            else
            {
                <ul class="adm-customer-list">
                    @foreach (var customer in Model.TopCustomers)
                    {
                        var width = (double)(customer.TotalSpent / maxCustomerSpent) * 100;

                        <li>
                            <span class="adm-avatar-sm">@(string.IsNullOrWhiteSpace(customer.FullName) ? "?" : customer.FullName.Substring(0, 1).ToUpperInvariant())</span>
                            <div class="adm-customer-copy">
                                <a class="adm-customer-name" asp-area="Admin" asp-controller="Customers"
                                   asp-action="Details" asp-route-id="@customer.Id">@customer.FullName</a>
                                <div class="adm-bar-track is-thin">
                                    <span class="adm-bar-fill is-green" style="width: @F(width)%;"></span>
                                </div>
                                <span class="adm-order-meta">@customer.OrdersCount commande(s)</span>
                            </div>
                            <span class="adm-customer-spent">@customer.TotalSpent.ToString("N2") €</span>
                        </li>
                    }
                </ul>
            }
        </article>
    </div>
</section>
