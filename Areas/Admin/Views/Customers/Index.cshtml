@model AdminCustomerListViewModel

<div class="adm-page-head">
    <form class="adm-filters" method="get" asp-action="Index">
        <div class="adm-search">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="2" />
                <path d="m19.5 19.5-3.8-3.8" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            </svg>
            <input class="adm-input" type="search" name="search" value="@Model.Search"
                   placeholder="Nom, e-mail ou téléphone..." />
        </div>

        <button class="adm-btn is-primary" type="submit">Rechercher</button>

        @if (!string.IsNullOrWhiteSpace(Model.Search))
        {
            <a class="adm-btn" asp-action="Index">Réinitialiser</a>
        }
    </form>

    <span class="adm-card-sub">@Model.TotalCount client(s) inscrit(s)</span>
</div>

<div class="adm-card is-flush">
    @if (Model.Customers.Items.Count == 0)
    {
        <div class="adm-empty">
            <span class="adm-empty-icon" aria-hidden="true">
                <svg width="30" height="30" viewBox="0 0 24 24" fill="none">
                    <circle cx="9" cy="8" r="3.2" stroke="currentColor" stroke-width="1.6" />
                    <path d="M3.5 19c1.1-3.2 3.1-4.8 5.5-4.8S13.4 15.8 14.5 19" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                </svg>
            </span>
            <h3>Aucun client trouvé</h3>
            <p>Les comptes créés apparaîtront ici.</p>
        </div>
    }
    else
    {
        <div class="adm-table-wrap">
            <table class="adm-table">
                <thead>
                    <tr>
                        <th>Client</th>
                        <th>Téléphone</th>
                        <th class="is-end">Commandes</th>
                        <th class="is-end">Total dépensé</th>
                        <th>Dernière commande</th>
                        <th class="is-end"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var customer in Model.Customers.Items)
                    {
                        <tr>
                            <td>
                                <div class="adm-customer-cell">
                                    <span class="adm-avatar-sm">@(string.IsNullOrWhiteSpace(customer.FullName) ? "?" : customer.FullName.Substring(0, 1).ToUpperInvariant())</span>
                                    <div>
                                        <span class="adm-customer-name">@customer.FullName</span>
                                        <span class="adm-order-meta">@customer.Email</span>
                                    </div>
                                </div>
                            </td>
                            <td class="adm-cell-muted">@(string.IsNullOrWhiteSpace(customer.Phone) ? "—" : customer.Phone)</td>
                            <td class="is-end">@customer.OrdersCount</td>
                            <td class="is-end">@customer.TotalSpent.ToString("N2") TND</td>
                            <td>
                                @(customer.LastOrderDate.HasValue
                                    ? customer.LastOrderDate.Value.ToLocalTime().ToString("dd/MM/yyyy")
                                    : "—")
                            </td>
                            <td class="is-end">
                                <a class="adm-icon-btn" asp-action="Details" asp-route-id="@customer.Id"
                                   aria-label="Voir la fiche de @customer.FullName">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                        <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.Customers.TotalPages > 1)
        {
            <nav class="adm-pagination" aria-label="Pagination des clients">
                @if (Model.Customers.HasPreviousPage)
                {
                    <a class="adm-page-btn" asp-action="Index" asp-route-search="@Model.Search"
                       asp-route-page="@(Model.Customers.Page - 1)">Précédent</a>
                }
                else
                {
                    <span class="adm-page-btn is-disabled">Précédent</span>
                }

                @for (var pageNumber = 1; pageNumber <= Model.Customers.TotalPages; pageNumber++)
                {
                    if (pageNumber == Model.Customers.Page)
                    {
                        <span class="adm-page-btn is-current" aria-current="page">@pageNumber</span>
                    }
                    else
                    {
                        <a class="adm-page-btn" asp-action="Index" asp-route-search="@Model.Search"
                           asp-route-page="@pageNumber">@pageNumber</a>
                    }
                }

                @if (Model.Customers.HasNextPage)
                {
                    <a class="adm-page-btn" asp-action="Index" asp-route-search="@Model.Search"
                       asp-route-page="@(Model.Customers.Page + 1)">Suivant</a>
                }
                else
                {
                    <span class="adm-page-btn is-disabled">Suivant</span>
                }
            </nav>
        }
    }
</div>
