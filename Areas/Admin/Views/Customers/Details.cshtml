@model AdminCustomerDetailsViewModel

<div class="adm-page-head">
    <a class="adm-back" asp-action="Index">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="m15 6-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Retour aux clients
    </a>
</div>

<section class="adm-grid is-detail">
    <article class="adm-card">
        <div class="adm-customer-profile">
            <span class="adm-avatar-lg">
                @if (!string.IsNullOrWhiteSpace(Model.ProfilePictureUrl))
                {
                    <img src="@Model.ProfilePictureUrl" alt="Photo de @Model.FullName" />
                }
                else
                {
                    @(string.IsNullOrWhiteSpace(Model.FullName) ? "?" : Model.FullName.Substring(0, 1).ToUpperInvariant())
                }
            </span>
            <div>
                <h2 class="adm-card-title">@Model.FullName</h2>
                <p class="adm-card-sub">@Model.Email</p>
                @if (!string.IsNullOrWhiteSpace(Model.Phone))
                {
                    <p class="adm-card-sub">@Model.Phone</p>
                }
            </div>
        </div>
    </article>

    <article class="adm-card">
        <div class="adm-detail-grid">
            <div>
                <span class="adm-detail-label">Commandes</span>
                <strong class="adm-detail-value">@Model.OrdersCount</strong>
            </div>
            <div>
                <span class="adm-detail-label">Total dépensé</span>
                <strong class="adm-detail-value">@Model.TotalSpent.ToString("N2") TND</strong>
            </div>
            <div>
                <span class="adm-detail-label">Dernière commande</span>
                <strong class="adm-detail-value">
                    @(Model.LastOrderDate.HasValue
                        ? Model.LastOrderDate.Value.ToLocalTime().ToString("dd/MM/yyyy")
                        : "—")
                </strong>
            </div>
            <div>
                <span class="adm-detail-label">Panier moyen</span>
                <strong class="adm-detail-value">
                    @(Model.OrdersCount == 0 ? "0,00 TND" : (Model.TotalSpent / Model.OrdersCount).ToString("N2") + " TND")
                </strong>
            </div>
        </div>
    </article>
</section>

<article class="adm-card is-flush">
    <div class="adm-card-head is-inset">
        <div>
            <h2 class="adm-card-title">Historique des commandes</h2>
            <p class="adm-card-sub">Toutes les commandes de ce client</p>
        </div>
    </div>

    @if (Model.Orders.Count == 0)
    {
        <div class="adm-empty">
            <h3>Aucune commande</h3>
            <p>Ce client n'a pas encore passé de commande.</p>
        </div>
    }
    else
    {
        <div class="adm-table-wrap">
            <table class="adm-table">
                <thead>
                    <tr>
                        <th>Commande</th>
                        <th>Date</th>
                        <th class="is-end">Articles</th>
                        <th class="is-end">Montant</th>
                        <th>Statut</th>
                        <th>Paiement</th>
                        <th class="is-end"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model.Orders)
                    {
                        <tr>
                            <td><span class="adm-order-number">@order.OrderNumber</span></td>
                            <td>@order.OrderDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="is-end">@order.ItemCount</td>
                            <td class="is-end">@order.TotalAmount.ToString("N2") TND</td>
                            <td><span class="adm-badge @order.StatusBadgeClass">@order.StatusLabel</span></td>
                            <td><span class="adm-pay-badge">@order.PaymentStatusLabel</span></td>
                            <td class="is-end">
                                <a class="adm-icon-btn" asp-controller="Orders" asp-action="Details"
                                   asp-route-id="@order.Id" aria-label="Voir la commande @order.OrderNumber">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                        <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</article>
