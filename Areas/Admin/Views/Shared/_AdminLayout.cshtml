@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;

    string NavClass(string controller) =>
        string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
            ? "adm-nav-link is-active"
            : "adm-nav-link";

    var adminName = User.Identity?.Name ?? AdminDefaults.AdminEmail;
    var adminInitial = string.IsNullOrWhiteSpace(adminName)
        ? "A"
        : adminName.Trim().Substring(0, 1).ToUpperInvariant();
    var today = DateTime.Now.ToString(
        "dddd dd MMMM yyyy",
        System.Globalization.CultureInfo.GetCultureInfo("fr-FR"));
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0b1220" />
    <title>@ViewData["Title"] · TechZone Admin</title>
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="adm-body">
    <div class="adm-shell">
        <aside class="adm-sidebar" id="adm-sidebar">
            <a class="adm-brand" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                <img class="adm-brand-logo" src="~/images/logo/logo.png" alt="" width="42" height="42" />
                <span class="adm-brand-copy">
                    <strong>TechZone</strong>
                    <span>Administration</span>
                </span>
            </a>

            <nav class="adm-nav" aria-label="Navigation administration">
                <span class="adm-nav-label">Pilotage</span>
                <a class="@NavClass("Dashboard")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <rect x="3.5" y="3.5" width="7" height="7" rx="1.6" stroke="currentColor" stroke-width="1.8" />
                        <rect x="13.5" y="3.5" width="7" height="7" rx="1.6" stroke="currentColor" stroke-width="1.8" />
                        <rect x="3.5" y="13.5" width="7" height="7" rx="1.6" stroke="currentColor" stroke-width="1.8" />
                        <rect x="13.5" y="13.5" width="7" height="7" rx="1.6" stroke="currentColor" stroke-width="1.8" />
                    </svg>
                    Tableau de bord
                </a>

                <span class="adm-nav-label">Boutique</span>
                <a class="@NavClass("Orders")" asp-area="Admin" asp-controller="Orders" asp-action="Index">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M7 3h10l3 4v13H4V7l3-4Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
                        <path d="M4 7h16M9 11.5h6M9 15.5h4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                    </svg>
                    Commandes
                </a>
                <a class="@NavClass("Products")" asp-area="Admin" asp-controller="Products" asp-action="Index">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="m12 3 8 4.2v9.6L12 21l-8-4.2V7.2L12 3Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
                        <path d="m4.4 7.4 7.6 4 7.6-4M12 11.4V21" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
                    </svg>
                    Produits
                </a>
                <a class="@NavClass("Categories")" asp-area="Admin" asp-controller="Categories" asp-action="Index">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M4 5.5h6v6H4zM14 5.5h6v6h-6zM4 15.5h6v6H4zM14 15.5h6v6h-6z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
                    </svg>
                    Catégories
                </a>
                <a class="@NavClass("Customers")" asp-area="Admin" asp-controller="Customers" asp-action="Index">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <circle cx="9" cy="8" r="3.2" stroke="currentColor" stroke-width="1.8" />
                        <path d="M3.5 19c1.1-3.2 3.1-4.8 5.5-4.8S13.4 15.8 14.5 19" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                        <path d="M16 8.4a2.6 2.6 0 0 1 0 5M17.5 15.2c1.6.6 2.7 1.9 3.3 3.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                    </svg>
                    Clients
                </a>
            </nav>

            <div class="adm-sidebar-foot">
                <a class="adm-shop-link" asp-area="" asp-controller="Home" asp-action="Index">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M4 10.5 12 4l8 6.5V20H4v-9.5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
                        <path d="M9.5 20v-5h5v5" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
                    </svg>
                    Voir la boutique
                </a>
                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                    <button class="adm-logout" type="submit">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <path d="M14 5h4a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1h-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                            <path d="M10 8l-4 4 4 4M6 12h9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                        Déconnexion
                    </button>
                </form>
            </div>
        </aside>

        <div class="adm-main">
            <header class="adm-topbar">
                <div class="adm-topbar-copy">
                    <span class="adm-eyebrow">Espace administrateur</span>
                    <h1 class="adm-title">@ViewData["Title"]</h1>
                    @if (ViewData["AdminSubtitle"] is string subtitle)
                    {
                        <p class="adm-subtitle">@subtitle</p>
                    }
                </div>

                <div class="adm-topbar-right">
                    <span class="adm-date">@today</span>
                    <div class="adm-user">
                        <span class="adm-user-avatar">@adminInitial</span>
                        <span class="adm-user-copy">
                            <strong>@adminName</strong>
                            <span>Administrateur</span>
                        </span>
                    </div>
                </div>
            </header>

            <main class="adm-content" id="adm-content">
                @if (TempData["AdminSuccess"] is string successMessage)
                {
                    <div class="adm-alert is-success" role="status">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8" />
                            <path d="m8 12 2.5 2.5L16 9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                        <span>@successMessage</span>
                    </div>
                }
                @if (TempData["AdminError"] is string errorMessage)
                {
                    <div class="adm-alert is-error" role="alert">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8" />
                            <path d="M12 7.5v5.5M12 16.5h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                        </svg>
                        <span>@errorMessage</span>
                    </div>
                }

                @RenderBody()
            </main>

            <footer class="adm-footer">
                <span>TechZone Administration · @DateTime.Now.Year</span>
                <span>Tableau de bord interne</span>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
