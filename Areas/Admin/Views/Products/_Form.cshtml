@model AdminProductFormViewModel
@{
    var preview = string.IsNullOrWhiteSpace(Model.ExistingImageUrl)
        ? Model.ImageUrl
        : Model.ExistingImageUrl;
}

<div class="adm-form-grid">
    <div class="adm-field is-full">
        <label class="adm-label" asp-for="Name"></label>
        <input class="adm-input" asp-for="Name" placeholder="Ex. UltraBook Pro 14" />
        <span class="adm-field-error" asp-validation-for="Name"></span>
    </div>

    <div class="adm-field">
        <label class="adm-label" asp-for="CategoryId"></label>
        <select class="adm-input" asp-for="CategoryId">
            <option value="">— Choisir une catégorie —</option>
            @foreach (var category in Model.Categories)
            {
                <option value="@category.Id">@category.Name</option>
            }
        </select>
        <span class="adm-field-error" asp-validation-for="CategoryId"></span>
    </div>

    <div class="adm-field">
        <label class="adm-label" asp-for="Price"></label>
        <input class="adm-input" asp-for="Price" type="number" step="0.01" min="0" />
        <span class="adm-field-error" asp-validation-for="Price"></span>
    </div>

    <div class="adm-field">
        <label class="adm-label" asp-for="Stock"></label>
        <input class="adm-input" asp-for="Stock" type="number" min="0" />
        <span class="adm-field-error" asp-validation-for="Stock"></span>
    </div>

    <div class="adm-field">
        <label class="adm-label" asp-for="ImageUrl"></label>
        <input class="adm-input" asp-for="ImageUrl" placeholder="/images/products/mon-produit.svg" />
        <span class="adm-field-error" asp-validation-for="ImageUrl"></span>
    </div>

    <div class="adm-field is-full">
        <label class="adm-label" asp-for="Description"></label>
        <textarea class="adm-input adm-textarea" asp-for="Description" rows="5"
                  placeholder="Décrivez les caractéristiques principales du produit..."></textarea>
        <span class="adm-field-error" asp-validation-for="Description"></span>
    </div>

    <div class="adm-field is-full">
        <label class="adm-label" asp-for="ImageFile"></label>
        <div class="adm-upload">
            <input class="adm-input adm-file" asp-for="ImageFile" type="file" accept="image/png,image/jpeg,image/gif,image/webp,image/avif,image/bmp,image/tiff,image/svg+xml,image/x-icon,image/heic,image/heif" />
            <span class="adm-help">JPG, PNG, GIF, WEBP, AVIF, BMP, TIFF, SVG, ICO, HEIC ou HEIF · 10 Mo maximum. Le fichier remplace l'URL ci-dessus.</span>
            <span class="adm-field-error" asp-validation-for="ImageFile"></span>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(preview))
    {
        <div class="adm-field is-full">
            <span class="adm-label">Aperçu</span>
            <div class="adm-image-preview">
                <img src="@preview" alt="Aperçu du produit" />
            </div>
        </div>
    }
</div>
