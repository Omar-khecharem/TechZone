@model AdminProductListViewModel

<div class="adm-page-head">
    <form class="adm-filters" method="get" asp-action="Index">
        <div class="adm-search">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="2" />
                <path d="m19.5 19.5-3.8-3.8" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            </svg>
            <input class="adm-input" type="search" name="search" value="@Model.Search"
                   placeholder="Rechercher un produit..." />
        </div>

        <select class="adm-input adm-select" name="categoryId">
            <option value="">Toutes les catégories</option>
            @foreach (var category in Model.Categories)
            {
                <option value="@category.Id" selected="@(Model.CategoryId == category.Id ? "selected" : null)">@category.Name</option>
            }
        </select>

        <button class="adm-btn is-primary" type="submit">Filtrer</button>

        @if (!string.IsNullOrWhiteSpace(Model.Search) || Model.CategoryId.HasValue)
        {
            <a class="adm-btn" asp-action="Index">Réinitialiser</a>
        }
    </form>

    <a class="adm-btn is-primary" asp-action="Create">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
        Nouveau produit
    </a>
</div>

<div class="adm-card is-flush">
    <div class="adm-card-head is-inset">
        <div>
            <h2 class="adm-card-title">Catalogue</h2>
            <p class="adm-card-sub">@Model.TotalCount produit(s) au total</p>
        </div>
    </div>

    @if (Model.Products.Items.Count == 0)
    {
        <div class="adm-empty">
            <span class="adm-empty-icon" aria-hidden="true">
                <svg width="30" height="30" viewBox="0 0 24 24" fill="none">
                    <path d="m12 3 8 4.2v9.6L12 21l-8-4.2V7.2L12 3Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                    <path d="m4.4 7.4 7.6 4 7.6-4M12 11.4V21" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                </svg>
            </span>
            <h3>Aucun produit trouvé</h3>
            <p>Modifiez vos filtres ou ajoutez un nouveau produit au catalogue.</p>
            <a class="adm-btn is-primary" asp-action="Create">Ajouter un produit</a>
        </div>
    }
    else
    {
        <div class="adm-table-wrap">
            <table class="adm-table">
                <thead>
                    <tr>
                        <th>Produit</th>
                        <th>Catégorie</th>
                        <th class="is-end">Prix</th>
                        <th>Stock</th>
                        <th class="is-end">Ventes</th>
                        <th>Ajouté le</th>
                        <th class="is-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model.Products.Items)
                    {
                        var stockClass = product.Stock == 0
                            ? "is-cancelled"
                            : product.Stock <= 5 ? "is-shipped" : "is-delivered";

                        <tr>
                            <td>
                                <div class="adm-product-cell">
                                    <span class="adm-product-thumb">
                                        <img src="@product.ImageUrl" alt="" loading="lazy" />
                                    </span>
                                    <div>
                                        <span class="adm-product-name">@product.Name</span>
                                        <span class="adm-order-meta">Réf. #@product.Id</span>
                                    </div>
                                </div>
                            </td>
                            <td>@product.CategoryName</td>
                            <td class="is-end">@product.Price.ToString("N2") €</td>
                            <td>
                                <span class="adm-badge @stockClass">
                                    @(product.Stock == 0 ? "Rupture" : product.Stock.ToString())
                                </span>
                            </td>
                            <td class="is-end">@product.SalesCount</td>
                            <td>@product.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                            <td class="is-end">
                                <div class="adm-row-actions">
                                    <a class="adm-icon-btn" asp-action="Edit" asp-route-id="@product.Id"
                                       aria-label="Modifier @product.Name">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                            <path d="M4 20h4l10-10-4-4L4 16v4Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
                                            <path d="m13.5 6.5 4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                                        </svg>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@product.Id" method="post"
                                          onsubmit="return confirm('Supprimer définitivement « @product.Name » ?');">
                                        <button class="adm-icon-btn is-danger" type="submit" aria-label="Supprimer @product.Name">
                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                                <path d="M5 7h14M9 7V5h6v2M7 7l1 13h8l1-13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                                            </svg>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.Products.TotalPages > 1)
        {
            <nav class="adm-pagination" aria-label="Pagination des produits">
                @if (Model.Products.HasPreviousPage)
                {
                    <a class="adm-page-btn" asp-action="Index" asp-route-search="@Model.Search"
                       asp-route-categoryId="@Model.CategoryId" asp-route-page="@(Model.Products.Page - 1)">Précédent</a>
                }
                else
                {
                    <span class="adm-page-btn is-disabled">Précédent</span>
                }

                @for (var pageNumber = 1; pageNumber <= Model.Products.TotalPages; pageNumber++)
                {
                    if (pageNumber == Model.Products.Page)
                    {
                        <span class="adm-page-btn is-current" aria-current="page">@pageNumber</span>
                    }
                    else
                    {
                        <a class="adm-page-btn" asp-action="Index" asp-route-search="@Model.Search"
                           asp-route-categoryId="@Model.CategoryId" asp-route-page="@pageNumber">@pageNumber</a>
                    }
                }

                @if (Model.Products.HasNextPage)
                {
                    <a class="adm-page-btn" asp-action="Index" asp-route-search="@Model.Search"
                       asp-route-categoryId="@Model.CategoryId" asp-route-page="@(Model.Products.Page + 1)">Suivant</a>
                }
                else
                {
                    <span class="adm-page-btn is-disabled">Suivant</span>
                }
            </nav>
        }
    }
</div>
