@model AdminProductFormViewModel

<div class="adm-page-head">
    <a class="adm-back" asp-action="Index">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="m15 6-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Retour aux produits
    </a>
</div>

<div class="adm-card">
    <header class="adm-card-head">
        <div>
            <h2 class="adm-card-title">Informations du produit</h2>
            <p class="adm-card-sub">Renseignez les détails affichés dans la boutique</p>
        </div>
    </header>

    <form class="adm-form" asp-area="Admin" asp-controller="Products" asp-action="Create"
          method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="adm-validation"></div>

        <partial name="_Form" model="Model" />

        <div class="adm-form-actions">
            <button class="adm-btn is-primary" type="submit">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                </svg>
                Créer le produit
            </button>
            <a class="adm-btn" asp-action="Index">Annuler</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
