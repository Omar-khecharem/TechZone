@model string?

<div class="product-artwork" aria-hidden="true">
    @if (Model == "Smartphones")
    {
        <svg viewBox="0 0 180 140" focusable="false">
            <rect x="64" y="12" width="54" height="116" rx="12" fill="#19242d" />
            <rect x="69" y="19" width="44" height="100" rx="8" fill="#dce8e7" />
            <path d="M75 36c12-12 25-12 33 0v30c-10 10-22 13-33 3z" fill="#8bb4ac" />
            <circle cx="91" cy="109" r="3" fill="#19242d" />
        </svg>
    }
    else if (Model == "Écrans")
    {
        <svg viewBox="0 0 180 140" focusable="false">
            <rect x="27" y="20" width="126" height="78" rx="7" fill="#19242d" />
            <rect x="33" y="26" width="114" height="66" rx="3" fill="#dce8e7" />
            <path d="M40 77 70 48l19 17 20-23 32 35z" fill="#8bb4ac" />
            <path d="M81 99v13m18-13v13m-33 7h66" fill="none" stroke="#19242d" stroke-linecap="round" stroke-width="5" />
        </svg>
    }
    else if (Model == "Ordinateurs portables")
    {
        <svg viewBox="0 0 180 140" focusable="false">
            <rect x="42" y="18" width="96" height="76" rx="7" fill="#19242d" />
            <rect x="48" y="24" width="84" height="64" rx="3" fill="#e8e3d8" />
            <path d="m55 78 23-26 16 15 13-16 20 27z" fill="#bd8978" />
            <path d="M31 101h122l-9 13H40z" fill="#19242d" />
            <path d="M78 103h28" stroke="#7b858b" stroke-linecap="round" stroke-width="2" />
        </svg>
    }
    else
    {
        <svg viewBox="0 0 180 140" focusable="false">
            <path d="M51 71V59a39 39 0 0 1 78 0v12" fill="none" stroke="#19242d" stroke-linecap="round" stroke-width="11" />
            <rect x="42" y="65" width="21" height="39" rx="9" fill="#bd8978" />
            <rect x="117" y="65" width="21" height="39" rx="9" fill="#bd8978" />
            <path d="M127 100c-4 13-17 19-33 19h-7" fill="none" stroke="#19242d" stroke-linecap="round" stroke-width="4" />
            <circle cx="80" cy="119" r="4" fill="#19242d" />
        </svg>
    }
</div>
