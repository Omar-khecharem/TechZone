@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0d1014" />
    <title>@ViewData["Title"] - TechZone</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TechZone.styles.css" asp-append-version="true" />
    <script>
        document.documentElement.classList.add('js');
    </script>
</head>
<body>
    <a class="tz-skip" href="#main">Aller au contenu</a>

    <div class="tz-announcement" aria-label="Annonces TechZone">
        <div class="tz-container tz-announcement-inner">
            <svg class="tz-announcement-symbol" width="13" height="13" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 2l1.7 6.3L20 10l-6.3 1.7L12 18l-1.7-6.3L4 10l6.3-1.7z" fill="currentColor" />
            </svg>
            <div class="tz-announcement-track" data-announcement>
                <span class="tz-announcement-msg is-active"><b>Livraison offerte</b> dès 300 DT d'achat.</span>
                <span class="tz-announcement-msg">Paiement à la livraison partout en Tunisie.</span>
                <span class="tz-announcement-msg">Garantie officielle 12 mois sur les produits éligibles.</span>
                <span class="tz-announcement-msg">Support client 7j/7 — réponse en moins de 24h.</span>
            </div>
            <span class="tz-announcement-mark" aria-hidden="true">TZ — 2026</span>
        </div>
    </div>

    <header class="tz-header" data-header>
        <div class="tz-container tz-header-inner">
            <a class="tz-brand" asp-area="" asp-controller="Home" asp-action="Index" aria-label="TechZone, retour à l'accueil">
                <svg class="tz-brand-symbol" width="40" height="40" viewBox="0 0 40 40" aria-hidden="true">
                    <rect x="1" y="1" width="38" height="38" rx="11" fill="#111827" />
                    <path d="M11 12.5h18" stroke="#fff" stroke-width="2.8" stroke-linecap="round" />
                    <path d="M20 12.5v15" stroke="#fff" stroke-width="2.8" stroke-linecap="round" />
                    <path d="M11 26.5h5.5" stroke="#fff" stroke-width="1.6" stroke-linecap="round" opacity=".65" />
                    <circle cx="11" cy="26.5" r="2" fill="#2563eb" />
                    <circle cx="29" cy="12.5" r="1.6" fill="#2563eb" />
                </svg>
                <span class="tz-brand-text">Tech<span>Zone</span></span>
            </a>

            <div class="tz-search-slot" data-search-slot>
                <form id="tz-header-search" class="tz-search" asp-area="" asp-controller="Product" asp-action="Index" method="get" role="search">
                    <input class="tz-search-input" type="search" name="q" placeholder="Que recherchez-vous aujourd'hui ?" aria-label="Rechercher un produit" autocomplete="off" />
                    <button class="tz-search-submit" type="submit" aria-label="Lancer la recherche">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2.2" />
                            <path d="m20 20-3.9-3.9" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
                        </svg>
                    </button>
                </form>
            </div>

            <div class="tz-header-actions">
                <button class="tz-search-toggle" type="button" data-search-toggle aria-expanded="false" aria-controls="tz-header-search" aria-label="Ouvrir la recherche">
                    <svg class="tz-search-toggle-open" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="2" />
                        <path d="m19.5 19.5-3.8-3.8" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                    </svg>
                    <svg class="tz-search-toggle-close" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                    </svg>
                </button>

                <details class="tz-account">
                    <summary class="tz-action">
                        @await Component.InvokeAsync("UserAvatar")
                        <span class="tz-action-label">@(isAuthenticated ? "Compte" : "Connexion")</span>
                        <svg class="tz-caret" width="11" height="11" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </summary>
                    <div class="tz-account-menu">
                        @if (isAuthenticated)
                        {
                            <a asp-area="" asp-controller="Account" asp-action="Profile">Mon profil</a>
                            <a asp-area="" asp-controller="Order" asp-action="History">Mes commandes</a>
                            <a asp-area="" asp-controller="Cart" asp-action="Index">Mon panier</a>
                            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit" class="tz-account-logout">Déconnexion</button>
                            </form>
                        }
                        else
                        {
                            <a asp-area="" asp-controller="Account" asp-action="Login">Se connecter</a>
                            <a asp-area="" asp-controller="Account" asp-action="Register" class="tz-account-secondary">Créer un compte</a>
                        }
                    </div>
                </details>

                <a class="tz-action tz-action-cart" asp-area="" asp-controller="Cart" asp-action="Index" aria-label="Voir le panier">
                    <span class="tz-action-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <path d="M6 8h12l-1 12H7L6 8Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
                            <path d="M9 8V6a3 3 0 0 1 6 0v2" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                        </svg>
                        @await Component.InvokeAsync("CartBadge")
                    </span>
                </a>

                <button class="tz-burger" type="button" data-menu-toggle aria-expanded="false" aria-controls="tz-mobile" aria-label="Ouvrir le menu">
                    <span></span><span></span><span></span>
                </button>
            </div>
        </div>

        <div class="tz-container tz-navbar">
            @await Component.InvokeAsync("CategoryNav")
            <a class="tz-nav-quick" asp-area="" asp-controller="Product" asp-action="Index">
                Tout le catalogue
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </a>
        </div>
    </header>

    <div class="tz-mobile" id="tz-mobile" data-mobile hidden>
        <div class="tz-mobile-inner">
            <div class="tz-mobile-top">
                <span class="tz-brand-text">Tech<span>Zone</span></span>
                <button class="tz-mobile-close" type="button" data-menu-close aria-label="Fermer le menu">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                    </svg>
                </button>
            </div>

            <form class="tz-mobile-search" asp-area="" asp-controller="Product" asp-action="Index" method="get" role="search">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2.2" />
                    <path d="m20 20-3.9-3.9" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
                </svg>
                <input type="search" name="q" placeholder="Que recherchez-vous aujourd'hui ?" aria-label="Rechercher un produit" />
            </form>

            <nav class="tz-mobile-nav" aria-label="Navigation mobile">
                <a asp-area="" asp-controller="Home" asp-action="Index">Accueil</a>
                <a asp-area="" asp-controller="Product" asp-action="Index">Catalogue</a>
                <a asp-area="" asp-controller="Cart" asp-action="Index">Panier</a>
            </nav>

            <div class="tz-mobile-categories">
                <p class="tz-mobile-heading">Catégories</p>
                @await Component.InvokeAsync("CategoryNav", new { showPrimaryLinks = false })
            </div>

            <div class="tz-mobile-account">
                <p class="tz-mobile-heading">Mon compte</p>
                @if (isAuthenticated)
                {
                    <a asp-area="" asp-controller="Account" asp-action="Profile">Mon profil</a>
                    <a asp-area="" asp-controller="Order" asp-action="History">Mes commandes</a>
                    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="tz-mobile-logout">Déconnexion</button>
                    </form>
                }
                else
                {
                    <a asp-area="" asp-controller="Account" asp-action="Login">Se connecter</a>
                    <a asp-area="" asp-controller="Account" asp-action="Register">Créer un compte</a>
                }
            </div>
        </div>
    </div>

    <main class="tz-main" id="main" role="main">
        @RenderBody()
    </main>

    <footer class="tz-footer">
        <div class="tz-container tz-footer-top">
            <div class="tz-footer-brand">
                <a class="tz-brand" asp-area="" asp-controller="Home" asp-action="Index" aria-label="TechZone, retour à l'accueil">
                    <svg class="tz-brand-symbol" width="36" height="36" viewBox="0 0 40 40" aria-hidden="true">
                        <rect x="1" y="1" width="38" height="38" rx="11" fill="#111827" />
                        <path d="M11 12.5h18" stroke="#fff" stroke-width="2.8" stroke-linecap="round" />
                        <path d="M20 12.5v15" stroke="#fff" stroke-width="2.8" stroke-linecap="round" />
                        <path d="M11 26.5h5.5" stroke="#fff" stroke-width="1.6" stroke-linecap="round" opacity=".65" />
                        <circle cx="11" cy="26.5" r="2" fill="#2563eb" />
                        <circle cx="29" cy="12.5" r="1.6" fill="#2563eb" />
                    </svg>
                    <span class="tz-brand-text">Tech<span>Zone</span></span>
                </a>
                <p>Une sélection technologique pensée pour travailler, créer et rester connecté.</p>
            </div>

            <div class="tz-footer-cols">
                <div class="tz-footer-col">
                    <h3>Boutique</h3>
                    <a asp-area="" asp-controller="Product" asp-action="Index">Tout le catalogue</a>
                    <a asp-area="" asp-controller="Home" asp-action="Index">Accueil</a>
                </div>
                <div class="tz-footer-col">
                    <h3>Compte</h3>
                    @if (isAuthenticated)
                    {
                        <a asp-area="" asp-controller="Account" asp-action="Profile">Mon profil</a>
                        <a asp-area="" asp-controller="Order" asp-action="History">Mes commandes</a>
                    }
                    else
                    {
                        <a asp-area="" asp-controller="Account" asp-action="Login">Se connecter</a>
                        <a asp-area="" asp-controller="Account" asp-action="Register">Créer un compte</a>
                    }
                    <a asp-area="" asp-controller="Cart" asp-action="Index">Mon panier</a>
                </div>
                <div class="tz-footer-col">
                    <h3>Informations</h3>
                    <a asp-area="" asp-controller="Home" asp-action="Privacy">Confidentialité</a>
                    <a asp-area="" asp-controller="Product" asp-action="Index">Catalogue</a>
                </div>
            </div>
        </div>

        <div class="tz-container tz-footer-bottom">
            <span>&copy; @DateTime.Now.Year TechZone. Tous droits réservés.</span>
            <span class="tz-footer-note">La technologie, bien choisie.</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
