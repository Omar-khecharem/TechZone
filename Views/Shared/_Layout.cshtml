<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TechZone</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TechZone.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="site-header-inner">
            <a class="site-brand" asp-area="" asp-controller="Home" asp-action="Index" aria-label="TechZone, accueil">
                <span class="site-brand-mark" aria-hidden="true">T</span>
                <span>Tech<span>Zone</span></span>
            </a>
            <nav class="site-navigation" aria-label="Navigation principale">
                <a asp-area="" asp-controller="Home" asp-action="Index">Accueil</a>
                <a asp-area="" asp-controller="Product" asp-action="Index">Catalogue</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-area="" asp-controller="Cart" asp-action="Index">Panier</a>
                    <a asp-area="" asp-controller="Order" asp-action="History">Mes commandes</a>
                    <a asp-area="" asp-controller="Account" asp-action="Profile">Mon profil</a>
                    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="site-nav-logout">Déconnexion</button>
                    </form>
                }
                else
                {
                    <a asp-area="" asp-controller="Account" asp-action="Login">Connexion</a>
                    <a class="site-nav-cta" asp-area="" asp-controller="Account" asp-action="Register">Créer un compte <span aria-hidden="true">→</span></a>
                }
            </nav>
        </div>
    </header>
    <main class="site-main" role="main">
        @RenderBody()
    </main>
    <footer class="site-footer">
        <div class="site-footer-inner">
            <a class="site-brand site-footer-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="site-brand-mark" aria-hidden="true">T</span>
                <span>Tech<span>Zone</span></span>
            </a>
            <p>La technologie, bien choisie.</p>
            <span>&copy; @DateTime.Now.Year TechZone</span>
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Confidentialité</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
