@model IReadOnlyList<Category>
@{
    var showPrimaryLinks = ViewData["ShowPrimaryLinks"] as bool? ?? true;
    var currentController = ViewContext.RouteData.Values["controller"] as string ?? string.Empty;
    var currentAction = ViewContext.RouteData.Values["action"] as string ?? string.Empty;
    int? currentCategoryId = int.TryParse(Context.Request.Query["categoryId"], out var parsedCategoryId)
        ? parsedCategoryId
        : null;
    var isHome = string.Equals(currentController, "Home", StringComparison.OrdinalIgnoreCase)
        && string.Equals(currentAction, "Index", StringComparison.OrdinalIgnoreCase);
    var isCatalog = string.Equals(currentController, "Product", StringComparison.OrdinalIgnoreCase)
        && string.Equals(currentAction, "Index", StringComparison.OrdinalIgnoreCase);
}

<nav class="tz-nav" aria-label="Navigation principale">
    @if (showPrimaryLinks)
    {
        <a asp-area="" asp-controller="Home" asp-action="Index" class="tz-nav-link @(isHome ? "is-active" : null)">Accueil</a>
        <a asp-area="" asp-controller="Product" asp-action="Index" class="tz-nav-link @(isCatalog && !currentCategoryId.HasValue ? "is-active" : null)">Catalogue</a>
    }

    @if (Model is { Count: > 0 })
    {
        foreach (var category in Model)
        {
            <a asp-area="" asp-controller="Product" asp-action="Index" asp-route-categoryId="@category.Id"
               class="tz-nav-link @(currentCategoryId == category.Id ? "is-active" : null)">@category.Name</a>
        }
    }
</nav>
