@model HomeViewModel
@{
    ViewData["Title"] = "Accueil";
    var featuredProduct = Model.FeaturedProducts.FirstOrDefault();
}

<div class="home-page">
    <section class="home-hero" aria-labelledby="home-title">
        <div class="home-hero-copy">
            <p class="home-eyebrow"><span class="home-eyebrow-dot"></span> Le meilleur de la tech, tout simplement</p>
            <h1 id="home-title">La technologie qui vous fait <span>avancer.</span></h1>
            <p class="home-hero-description">
                Des produits soigneusement sélectionnés pour travailler, créer et profiter pleinement de chaque instant.
            </p>
            <div class="home-hero-actions">
                <a class="home-button home-button-primary" asp-controller="Product" asp-action="Index">
                    Explorer le catalogue <span aria-hidden="true">→</span>
                </a>
                <a class="home-text-link" href="#selection">Découvrir la sélection</a>
            </div>
            <div class="home-trust-row" aria-label="Les engagements TechZone">
                <span><span class="home-check" aria-hidden="true">✓</span> Sélection exigeante</span>
                <span><span class="home-check" aria-hidden="true">✓</span> Prix transparents</span>
            </div>
        </div>

        <div class="home-hero-visual">
            <div class="home-visual-orbit home-visual-orbit-one"></div>
            <div class="home-visual-orbit home-visual-orbit-two"></div>
            @if (featuredProduct is not null)
            {
                <a class="home-showcase-card" asp-controller="Product" asp-action="Details" asp-route-id="@featuredProduct.Id">
                    <span class="home-showcase-label">Le choix de la communauté</span>
                    <img src="@featuredProduct.ImageUrl" alt="@featuredProduct.Name" />
                    <span class="home-showcase-details">
                        <span>
                            <span class="home-showcase-category">@featuredProduct.CategoryName</span>
                            <strong>@featuredProduct.Name</strong>
                        </span>
                        <span class="home-showcase-price">@featuredProduct.Price.ToString("N2") €</span>
                    </span>
                </a>
            }
            else if (Model.FeaturedProducts.Count == 1)
            {
                <div class="home-empty-state">
                    <h3>D'autres produits arrivent bientôt</h3>
                    <p>En attendant, retrouvez notre sélection actuelle dans le catalogue.</p>
                    <a class="home-button home-button-primary" asp-controller="Product" asp-action="Index">Visiter le catalogue</a>
                </div>
            }
            else
            {
                <div class="home-showcase-empty" aria-hidden="true">
                    <span class="home-showcase-empty-mark">TZ</span>
                    <span>La technologie, bien choisie.</span>
                </div>
            }
            <div class="home-floating-note"><span aria-hidden="true">✦</span> La qualité avant tout</div>
        </div>
    </section>

    <section class="home-categories" aria-labelledby="categories-title">
        <div class="home-section-heading">
            <div>
                <p class="home-section-kicker">Trouvez votre prochain coup de cœur</p>
                <h2 id="categories-title">Explorer par catégorie</h2>
            </div>
            <a class="home-section-link" asp-controller="Product" asp-action="Index">Tout le catalogue <span aria-hidden="true">→</span></a>
        </div>
        <div class="home-category-grid">
            @for (var index = 0; index < Model.Categories.Count; index++)
            {
                var category = Model.Categories[index];
                <a class="home-category-card" asp-controller="Product" asp-action="Index" asp-route-categoryId="@category.Id">
                    <span class="home-category-number">0@(index + 1)</span>
                    <span class="home-category-name">@category.Name</span>
                    <span class="home-category-arrow" aria-hidden="true">↗</span>
                </a>
            }
        </div>
    </section>

    <section class="home-selection" id="selection" aria-labelledby="selection-title">
        <div class="home-section-heading">
            <div>
                <p class="home-section-kicker">Sélectionnés avec soin pour vous accompagner</p>
                <h2 id="selection-title">La sélection du moment</h2>
            </div>
            <a class="home-section-link" asp-controller="Product" asp-action="Index">Voir tous les produits <span aria-hidden="true">→</span></a>
        </div>

        @if (Model.FeaturedProducts.Count > 1)
        {
            <div class="home-product-grid">
                @foreach (var product in Model.FeaturedProducts.Skip(1))
                {
                    <article class="home-product-card">
                        <a class="home-product-image-link" asp-controller="Product" asp-action="Details" asp-route-id="@product.Id" aria-label="Découvrir @product.Name">
                            <img class="home-product-image" src="@product.ImageUrl" alt="@product.Name" loading="lazy" />
                            <span class="home-product-image-arrow" aria-hidden="true">↗</span>
                        </a>
                        <div class="home-product-info">
                            <p class="home-product-category">@product.CategoryName</p>
                            <div class="home-product-title-row">
                                <h3><a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id">@product.Name</a></h3>
                                <span class="home-product-price">@product.Price.ToString("N2") €</span>
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="home-empty-state">
                <h3>Notre sélection se prépare</h3>
                <p>Le catalogue sera bientôt disponible. Revenez nous voir prochainement.</p>
                <a class="home-button home-button-primary" asp-controller="Product" asp-action="Index">Visiter le catalogue</a>
            </div>
        }
    </section>

    <section class="home-bottom-cta" aria-labelledby="home-cta-title">
        <div>
            <p class="home-section-kicker">Un choix plus simple, une meilleure expérience</p>
            <h2 id="home-cta-title">La bonne technologie commence ici.</h2>
        </div>
        <a class="home-button home-button-light" asp-controller="Product" asp-action="Index">Trouver votre prochain produit <span aria-hidden="true">→</span></a>
    </section>
</div>
