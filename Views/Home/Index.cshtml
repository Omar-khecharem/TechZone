@model HomeViewModel
@using System.IO
@using System.Text
@using System.Globalization
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment WebHost
@functions {
    private const string PlaceholderImage = "/images/placeholder-tech.svg";

    private string ResolveProductImage(string imageUrl, string productName)
    {
        if (!string.IsNullOrWhiteSpace(imageUrl))
        {
            var relativePath = imageUrl.TrimStart('/').Replace('/', System.IO.Path.DirectorySeparatorChar);
            if (System.IO.File.Exists(System.IO.Path.Combine(WebHost.WebRootPath, relativePath)))
            {
                return imageUrl;
            }
        }

        var normalized = productName.Normalize(NormalizationForm.FormD);
        var builder = new StringBuilder(normalized.Length);
        foreach (var character in normalized)
        {
            if (CharUnicodeInfo.GetUnicodeCategory(character) != UnicodeCategory.NonSpacingMark)
            {
                builder.Append(character);
            }
        }

        var slug = System.Text.RegularExpressions.Regex
            .Replace(builder.ToString().ToLowerInvariant(), "[^a-z0-9]+", "-")
            .Trim('-');

        var candidate = $"/images/products/{slug}.svg";
        var candidatePath = System.IO.Path.Combine(WebHost.WebRootPath, "images", "products", slug + ".svg");

        return System.IO.File.Exists(candidatePath) ? candidate : PlaceholderImage;
    }
}
@{
    ViewData["Title"] = "Accueil";

    var products = Model.FeaturedProducts;

    Func<string, ProductCardViewModel> findCategory = name =>
        products.FirstOrDefault(p => string.Equals(p.CategoryName, name, StringComparison.OrdinalIgnoreCase))!;

    var heroLaptop = findCategory("Ordinateurs portables") ?? products.FirstOrDefault();
    var heroPhone = findCategory("Smartphones") ?? products.ElementAtOrDefault(1);
    var heroAudio = products.FirstOrDefault(p => p.Name.Contains("Casque", StringComparison.OrdinalIgnoreCase))
                    ?? findCategory("Accessoires");
    var editorialProduct = products.FirstOrDefault(p => p.Name.Contains("Studio", StringComparison.OrdinalIgnoreCase))
                           ?? findCategory("Ordinateurs portables")
                           ?? products.LastOrDefault();

    var selection = products.Take(6).ToList();
    var heroCategories = Model.Categories.Take(4).ToList();
}

<div class="home">

    @* ============================ HERO ============================ *@
    <section class="home-hero" aria-labelledby="home-title">
        <div class="tz-container home-hero-inner">
            <div class="home-hero-copy">
                <p class="home-eyebrow">TechZone · L'univers technologique</p>

                <h1 class="home-title" id="home-title">Le futur <em>se choisit.</em></h1>

                <p class="home-lead">
                    Des équipements pensés pour travailler, créer et rester connecté.
                    Explorez une sélection technologique qui accompagne vos ambitions.
                </p>

                <div class="home-actions">
                    <a class="home-btn home-btn-primary" asp-controller="Product" asp-action="Index">
                        Explorer les produits
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </a>
                    <a class="home-btn home-btn-ghost" href="#selection">Voir les nouveautés</a>
                </div>

                <div class="home-hero-meta">
                    @if (heroCategories.Count > 0)
                    {
                        foreach (var category in heroCategories)
                        {
                            <span>@category.Name</span>
                        }
                    }
                    else
                    {
                        <span>Ordinateurs</span>
                        <span>Smartphones</span>
                        <span>Écrans</span>
                        <span>Accessoires</span>
                    }
                </div>
            </div>

            <div class="home-visual">
                <div class="home-visual-stage">
                    @if (heroLaptop is not null)
                    {
                        <a class="home-visual-card home-visual-main" asp-controller="Product" asp-action="Details" asp-route-id="@heroLaptop.Id">
                            <img src="@ResolveProductImage(heroLaptop.ImageUrl, heroLaptop.Name)" alt="@heroLaptop.Name" />
                            <span class="vis-caption">
                                <span class="vis-cat">@heroLaptop.CategoryName</span>
                                <span class="vis-name">@heroLaptop.Name</span>
                            </span>
                        </a>
                    }

                    @if (heroPhone is not null)
                    {
                        <a class="home-visual-card home-visual-phone" asp-controller="Product" asp-action="Details" asp-route-id="@heroPhone.Id">
                            <img src="@ResolveProductImage(heroPhone.ImageUrl, heroPhone.Name)" alt="@heroPhone.Name" />
                            <span class="vis-caption">
                                <span class="vis-cat">@heroPhone.CategoryName</span>
                                <span class="vis-name">@heroPhone.Name</span>
                            </span>
                        </a>
                    }

                    @if (heroAudio is not null)
                    {
                        <a class="home-visual-card home-visual-chip" asp-controller="Product" asp-action="Details" asp-route-id="@heroAudio.Id">
                            <img src="@ResolveProductImage(heroAudio.ImageUrl, heroAudio.Name)" alt="@heroAudio.Name" />
                            <span class="vis-caption">
                                <span class="vis-cat">@heroAudio.CategoryName</span>
                                <span class="vis-name">@heroAudio.Name</span>
                            </span>
                        </a>
                    }

                    <div class="home-badge" aria-hidden="true">
                        <svg class="home-badge-ring" viewBox="0 0 120 120">
                            <defs>
                                <path id="tzBadgePath" d="M60,60 m-44,0 a44,44 0 1,1 88,0 a44,44 0 1,1 -88,0" />
                            </defs>
                            <text>
                                <textPath href="#tzBadgePath" startOffset="0">Sélection TechZone · Édition 2026 ·</textPath>
                            </text>
                        </svg>
                        <span class="home-badge-core">
                            <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M12 2l1.7 6.3L20 10l-6.3 1.7L12 18l-1.7-6.3L4 10l6.3-1.7z" fill="currentColor" />
                            </svg>
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <div class="tz-container">
            <ul class="home-values">
                <li class="home-value">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <rect x="4" y="4" width="7" height="7" rx="1.6" stroke="currentColor" stroke-width="2" />
                        <rect x="13" y="4" width="7" height="7" rx="1.6" stroke="currentColor" stroke-width="2" />
                        <rect x="4" y="13" width="7" height="7" rx="1.6" stroke="currentColor" stroke-width="2" />
                        <rect x="13" y="13" width="7" height="7" rx="1.6" stroke="currentColor" stroke-width="2" />
                    </svg>
                    Catalogue complet
                </li>
                <li class="home-value">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M7 3h7l4 4v14H7z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
                        <path d="M14 3v4h4M10 12h5M10 16h5" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                    </svg>
                    Fiches détaillées
                </li>
                <li class="home-value">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <rect x="3" y="6" width="18" height="12" rx="2.4" stroke="currentColor" stroke-width="2" />
                        <path d="M3 10h18M7 15h3" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                    </svg>
                    Paiement en ligne
                </li>
                <li class="home-value">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M3 7h11v10H3zM14 10h4l3 3v4h-7" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
                        <circle cx="7" cy="18" r="1.8" stroke="currentColor" stroke-width="2" />
                        <circle cx="17.5" cy="18" r="1.8" stroke="currentColor" stroke-width="2" />
                    </svg>
                    Suivi de commande
                </li>
            </ul>
        </div>
    </section>

    @* ============================ CATEGORIES ============================ *@
    <section class="home-section" aria-labelledby="categories-title">
        <div class="tz-container">
            <div class="home-section-head">
                <div>
                    <span class="home-kicker">Explorer par catégorie</span>
                    <h2 class="home-section-title" id="categories-title">Trouvez votre prochain essentiel.</h2>
                    <p class="home-section-lead">Quatre univers complémentaires pour composer un environnement technologique cohérent.</p>
                </div>
                <a class="home-section-link" asp-controller="Product" asp-action="Index">
                    Tout le catalogue
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </a>
            </div>

            @if (Model.Categories.Count > 0)
            {
                <div class="home-cats">
                    @foreach (var category in Model.Categories)
                    {
                        var name = category.Name;
                        var isLaptop = name.Contains("Ordinateur", StringComparison.OrdinalIgnoreCase);
                        var isPhone = name.Contains("Smartphone", StringComparison.OrdinalIgnoreCase) || name.Contains("Téléphone", StringComparison.OrdinalIgnoreCase);
                        var isScreen = name.Contains("Écran", StringComparison.OrdinalIgnoreCase) || name.Contains("Ecran", StringComparison.OrdinalIgnoreCase);

                        var description = category.Description;
                        if (string.IsNullOrWhiteSpace(description))
                        {
                            description = isLaptop ? "Puissance et mobilité pour travailler et créer."
                                : isPhone ? "Des mobiles connectés à votre quotidien."
                                : isScreen ? "Des moniteurs pensés pour chaque usage."
                                : "Périphériques et audio pour compléter votre setup.";
                        }

                        <a class="home-cat" asp-controller="Product" asp-action="Index" asp-route-categoryId="@category.Id">
                            <span class="home-cat-arrow" aria-hidden="true">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                                    <path d="M7 17 17 7M9 7h8v8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                            </span>

                            <div class="home-cat-art">
                                @if (isLaptop)
                                {
                                    <svg viewBox="0 0 160 120" fill="none" aria-hidden="true">
                                        <rect x="34" y="24" width="92" height="60" rx="6" stroke="currentColor" stroke-width="3" />
                                        <rect x="41" y="31" width="78" height="46" rx="3" stroke="currentColor" stroke-width="2" opacity=".6" />
                                        <path d="M52 66c8-15 16-21 24-15 7 5 11 12 18 4 5-5 8-9 14-2" stroke="#2563EB" stroke-width="3" stroke-linecap="round" />
                                        <path d="M22 92h116l-8 10H30z" stroke="currentColor" stroke-width="3" stroke-linejoin="round" />
                                        <path d="M68 96h24" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
                                    </svg>
                                }
                                else if (isPhone)
                                {
                                    <svg viewBox="0 0 160 120" fill="none" aria-hidden="true">
                                        <rect x="60" y="14" width="42" height="92" rx="10" stroke="currentColor" stroke-width="3" />
                                        <rect x="66" y="21" width="30" height="70" rx="5" stroke="currentColor" stroke-width="2" opacity=".55" />
                                        <path d="M72 42c6-6 12-6 18 0v18c-5 5-12 6-18 2z" fill="#2563EB" opacity=".16" />
                                        <path d="M72 42c6-6 12-6 18 0" stroke="#2563EB" stroke-width="2.4" stroke-linecap="round" />
                                        <circle cx="81" cy="98" r="2.6" fill="#2563EB" />
                                        <path d="M118 34c6 4 6 12 0 16M126 28c9 7 9 21 0 28" stroke="#2563EB" stroke-width="2.4" stroke-linecap="round" opacity=".8" />
                                    </svg>
                                }
                                else if (isScreen)
                                {
                                    <svg viewBox="0 0 160 120" fill="none" aria-hidden="true">
                                        <rect x="26" y="20" width="108" height="66" rx="6" stroke="currentColor" stroke-width="3" />
                                        <rect x="33" y="27" width="94" height="52" rx="3" stroke="currentColor" stroke-width="2" opacity=".55" />
                                        <path d="M41 68l20-22 14 13 16-18 22 27z" fill="#2563EB" opacity=".16" />
                                        <path d="M41 68l20-22 14 13 16-18 22 27" stroke="#2563EB" stroke-width="2.4" stroke-linejoin="round" />
                                        <path d="M70 86v9m20-9v9m-30 6h40" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
                                    </svg>
                                }
                                else
                                {
                                    <svg viewBox="0 0 160 120" fill="none" aria-hidden="true">
                                        <path d="M56 70V58a24 24 0 0 1 48 0v12" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
                                        <rect x="48" y="66" width="14" height="26" rx="7" fill="#fff" stroke="currentColor" stroke-width="3" />
                                        <rect x="98" y="66" width="14" height="26" rx="7" fill="#fff" stroke="currentColor" stroke-width="3" />
                                        <path d="M105 92c-3 8-11 12-21 12h-6" stroke="#2563EB" stroke-width="2.6" stroke-linecap="round" />
                                        <circle cx="74" cy="104" r="3" fill="#2563EB" />
                                        <path d="M36 34c6 0 10 4 10 10v6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" opacity=".45" />
                                    </svg>
                                }
                            </div>

                            <div class="home-cat-info">
                                <div class="home-cat-name">@category.Name</div>
                                <div class="home-cat-desc">@description</div>
                            </div>
                        </a>
                    }
                </div>

                <a class="home-cat-all" asp-controller="Product" asp-action="Index">
                    <strong>Explorer l'ensemble du catalogue</strong>
                    <span>
                        Voir tous les produits
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </span>
                </a>
            }
        </div>
    </section>

    @* ============================ SELECTION ============================ *@
    <section class="home-section" id="selection" aria-labelledby="selection-title">
        <div class="tz-container">
            <div class="home-section-head">
                <div>
                    <span class="home-kicker">Sélection du moment</span>
                    <h2 class="home-section-title" id="selection-title">Des produits pensés pour durer.</h2>
                    <p class="home-section-lead">Une sélection resserrée d'ordinateurs, mobiles et accessoires choisis pour leur cohérence.</p>
                </div>
                <a class="home-section-link" asp-controller="Product" asp-action="Index">
                    Voir tous les produits
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </a>
            </div>

            @if (selection.Count > 0)
            {
                <div class="home-products">
                    @foreach (var product in selection)
                    {
                        <article class="home-product">
                            <a class="home-product-media" asp-controller="Product" asp-action="Details" asp-route-id="@product.Id" aria-label="Découvrir @product.Name">
                                <img src="@ResolveProductImage(product.ImageUrl, product.Name)" alt="@product.Name" loading="lazy" />
                                <span class="home-product-arrow" aria-hidden="true">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none">
                                        <path d="M7 17 17 7M9 7h8v8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                </span>
                            </a>
                            <div class="home-product-body">
                                <span class="home-product-cat">@product.CategoryName</span>
                                <h3 class="home-product-name">
                                    <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id">@product.Name</a>
                                </h3>
                                <div class="home-product-foot">
                                    <span class="home-product-price">@product.Price.ToString("N2") €</span>
                                    <a class="home-product-cta" asp-controller="Product" asp-action="Details" asp-route-id="@product.Id">
                                        Voir le produit
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                            <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                        </svg>
                                    </a>
                                </div>
                            </div>
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="home-cat-all">
                    <strong>Le catalogue se prépare</strong>
                    <span>Revenez prochainement pour découvrir la sélection.</span>
                </div>
            }
        </div>
    </section>

    @* ============================ EDITORIAL ============================ *@
    <section class="home-editorial" aria-labelledby="editorial-title">
        <div class="tz-container">
            <div class="home-editorial-inner">
                <div class="home-editorial-copy">
                    <span class="home-kicker">Curation TechZone</span>
                    <h2 class="home-editorial-title" id="editorial-title">Choisir mieux.<br />Vivre mieux.</h2>
                    <p class="home-editorial-text">
                        Nous réunissons des équipements qui se complètent : une machine pour créer,
                        un mobile pour rester connecté, des accessoires pour affiner l'expérience.
                        Une sélection lisible, sans superflu.
                    </p>
                    <div class="home-editorial-actions">
                        <a class="home-btn home-btn-light" asp-controller="Product" asp-action="Index">
                            Parcourir le catalogue
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </a>
                    </div>
                </div>

                @if (editorialProduct is not null)
                {
                    <div class="home-editorial-art">
                        <img src="@ResolveProductImage(editorialProduct.ImageUrl, editorialProduct.Name)" alt="@editorialProduct.Name" loading="lazy" />
                    </div>
                }
            </div>
        </div>
    </section>

    @* ============================ FAQ ============================ *@
    <section class="home-section" aria-labelledby="faq-title">
        <div class="tz-container home-faq-grid">
            <div class="home-faq-head">
                <span class="home-kicker">Questions fréquentes</span>
                <h2 class="home-section-title" id="faq-title">Vous avez une question ?</h2>
                <p class="home-section-lead">Quelques réponses pour vous aider à choisir.</p>
            </div>

            <div class="home-faq-list">
                <div class="home-faq-item">
                    <button class="home-faq-trigger" type="button" aria-expanded="false" aria-controls="faq-panel-1">
                        Comment trouver un produit sur TechZone ?
                        <span class="home-faq-icon" aria-hidden="true"></span>
                    </button>
                    <div class="home-faq-panel" id="faq-panel-1" role="region">
                        <p class="home-faq-panel-inner">
                            Utilisez la barre de recherche en haut de page pour saisir un nom de produit,
                            ou parcourez le catalogue puis affinez les résultats par catégorie et par prix.
                        </p>
                    </div>
                </div>

                <div class="home-faq-item">
                    <button class="home-faq-trigger" type="button" aria-expanded="false" aria-controls="faq-panel-2">
                        Comment choisir un ordinateur adapté à mes besoins ?
                        <span class="home-faq-icon" aria-hidden="true"></span>
                    </button>
                    <div class="home-faq-panel" id="faq-panel-2" role="region">
                        <p class="home-faq-panel-inner">
                            Chaque fiche produit détaille la configuration : processeur, mémoire, stockage
                            et taille d'écran. Comparez ces informations selon votre usage — mobilité,
                            création ou multitâche — pour trouver le modèle le plus cohérent.
                        </p>
                    </div>
                </div>

                <div class="home-faq-item">
                    <button class="home-faq-trigger" type="button" aria-expanded="false" aria-controls="faq-panel-3">
                        Quels types de produits puis-je découvrir ?
                        <span class="home-faq-icon" aria-hidden="true"></span>
                    </button>
                    <div class="home-faq-panel" id="faq-panel-3" role="region">
                        <p class="home-faq-panel-inner">
                            TechZone regroupe des ordinateurs portables, des smartphones, des écrans
                            et des accessoires. Chaque catégorie est accessible depuis le menu
                            ou directement depuis la page d'accueil.
                        </p>
                    </div>
                </div>

                <div class="home-faq-item">
                    <button class="home-faq-trigger" type="button" aria-expanded="false" aria-controls="faq-panel-4">
                        Comment accéder au catalogue ?
                        <span class="home-faq-icon" aria-hidden="true"></span>
                    </button>
                    <div class="home-faq-panel" id="faq-panel-4" role="region">
                        <p class="home-faq-panel-inner">
                            Cliquez sur « Catalogue » dans la navigation ou sur l'un des boutons
                            « Explorer les produits ». Le catalogue complet est également accessible
                            depuis le pied de page.
                        </p>
                    </div>
                </div>

                <div class="home-faq-item">
                    <button class="home-faq-trigger" type="button" aria-expanded="false" aria-controls="faq-panel-5">
                        Comment suivre mes commandes ?
                        <span class="home-faq-icon" aria-hidden="true"></span>
                    </button>
                    <div class="home-faq-panel" id="faq-panel-5" role="region">
                        <p class="home-faq-panel-inner">
                            Une fois connecté, ouvrez votre compte puis « Mes commandes »
                            pour consulter l'historique et le détail de vos commandes.
                        </p>
                    </div>
                </div>

                <div class="home-faq-item">
                    <button class="home-faq-trigger" type="button" aria-expanded="false" aria-controls="faq-panel-6">
                        Ai-je besoin d'un compte pour commander ?
                        <span class="home-faq-icon" aria-hidden="true"></span>
                    </button>
                    <div class="home-faq-panel" id="faq-panel-6" role="region">
                        <p class="home-faq-panel-inner">
                            Oui. La création d'un compte est nécessaire pour ajouter des produits
                            au panier et finaliser une commande. Vous pouvez vous connecter
                            ou créer un compte depuis le menu Compte.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    @* ============================ CTA ============================ *@
    <section class="home-cta" aria-labelledby="home-cta-title">
        <div class="tz-container">
            <div class="home-cta-inner">
                <div class="home-cta-copy">
                    <span class="home-kicker">Et maintenant</span>
                    <h2 class="home-cta-title" id="home-cta-title">La bonne technologie commence ici.</h2>
                </div>
                <div class="home-cta-actions">
                    <a class="home-btn home-btn-primary" asp-controller="Product" asp-action="Index">
                        Découvrir le catalogue
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </a>
                </div>
            </div>
        </div>
    </section>

</div>
