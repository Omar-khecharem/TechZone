@model HomeViewModel
@using System.IO
@using System.Text
@using System.Globalization
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment WebHost
@functions {
    private const string PlaceholderImage = "/images/placeholder-tech.svg";

    private string ResolveProductImage(string imageUrl, string productName)
    {
        if (!string.IsNullOrWhiteSpace(imageUrl))
        {
            var relativePath = imageUrl.TrimStart('/').Replace('/', System.IO.Path.DirectorySeparatorChar);
            if (System.IO.File.Exists(System.IO.Path.Combine(WebHost.WebRootPath, relativePath)))
            {
                return imageUrl;
            }
        }

        var normalized = productName.Normalize(NormalizationForm.FormD);
        var builder = new StringBuilder(normalized.Length);
        foreach (var character in normalized)
        {
            if (CharUnicodeInfo.GetUnicodeCategory(character) != UnicodeCategory.NonSpacingMark)
            {
                builder.Append(character);
            }
        }

        var slug = System.Text.RegularExpressions.Regex
            .Replace(builder.ToString().ToLowerInvariant(), "[^a-z0-9]+", "-")
            .Trim('-');

        var candidate = $"/images/products/{slug}.svg";
        var candidatePath = System.IO.Path.Combine(WebHost.WebRootPath, "images", "products", slug + ".svg");

        return System.IO.File.Exists(candidatePath) ? candidate : PlaceholderImage;
    }
}
@{
    ViewData["Title"] = "Accueil";

    var products = Model.FeaturedProducts;
    var categories = Model.Categories;

    var spotlight = products.FirstOrDefault();
    var deal = products.ElementAtOrDefault(1) ?? spotlight;
    var picks = products.Take(8).ToList();

    var marqueeItems = new[]
    {
        "Livraison offerte dès 300 DT",
        "Paiement à la livraison",
        "Garantie officielle 12 mois",
        "Support expert 7j/7",
        "Retours sous 14 jours",
        "Paiement 100% sécurisé"
    };
}

<div class="hp-home">

    @* ============================ HERO ============================ *@
    <section class="hp-hero" data-hero aria-labelledby="hp-hero-title">
        <div class="hp-hero-media" aria-hidden="true">
            <div class="hp-hero-fallback"></div>
            <video class="hp-hero-video" data-hero-video autoplay muted loop playsinline preload="auto"
                   poster="@Url.Content("~/images/hero/hero-poster.svg")">
                <source src="~/media/hero.webm" type="video/webm" />
                <source src="~/media/hero.mp4" type="video/mp4" />
            </video>
            <div class="hp-hero-grid"></div>
            <div class="hp-hero-scrim"></div>
            <div class="hp-hero-glow" data-hero-glow></div>
        </div>

        <div class="tz-container hp-hero-inner">
            <div class="hp-hero-copy">
                <span class="hp-eyebrow" data-reveal>
                    <span class="hp-eyebrow-dot" aria-hidden="true"></span>
                    Collection 2026 — Sélection experte
                </span>

                <h1 class="hp-hero-title" id="hp-hero-title" data-reveal style="--d:60ms">
                    La technologie,<br /><em>sans compromis.</em>
                </h1>

                <p class="hp-hero-lead" data-reveal style="--d:120ms">
                    Ordinateurs, smartphones et audio triés sur le volet. Une expérience d'achat
                    fluide, un accompagnement d'expert et des garanties officielles.
                </p>

                <div class="hp-hero-actions" data-reveal style="--d:180ms">
                    <a class="hp-btn hp-btn-primary" asp-controller="Product" asp-action="Index">
                        Explorer le catalogue
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </a>
                    <a class="hp-btn hp-btn-ghost" href="#promotions">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <path d="M12 3l2.5 6.2L21 12l-6.5 2.8L12 21l-2.5-6.2L3 12l6.5-2.8z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
                        </svg>
                        Voir les offres
                    </a>
                </div>

                <ul class="hp-hero-stats" data-reveal style="--d:240ms">
                    <li><b>120+</b><span>Références premium</span></li>
                    <li><b>4.9/5</b><span>Satisfaction client</span></li>
                    <li><b>24h</b><span>Livraison express</span></li>
                </ul>
            </div>

            <div class="hp-hero-visual" data-reveal style="--d:220ms">
                @if (spotlight is not null)
                {
                    <article class="hp-spot">
                        <a class="hp-spot-media" asp-controller="Product" asp-action="Details" asp-route-id="@spotlight.Id" aria-label="Découvrir @spotlight.Name">
                            <img src="@ResolveProductImage(spotlight.ImageUrl, spotlight.Name)" alt="@spotlight.Name" />
                        </a>
                        <div class="hp-spot-body">
                            <span class="hp-spot-tag">Coup de cœur</span>
                            <span class="hp-spot-cat">@spotlight.CategoryName</span>
                            <h2 class="hp-spot-name">
                                <a asp-controller="Product" asp-action="Details" asp-route-id="@spotlight.Id">@spotlight.Name</a>
                            </h2>
                            <div class="hp-spot-foot">
                                <span class="hp-spot-price">@spotlight.Price.ToString("N2") €</span>
                                <a class="hp-spot-cta" asp-controller="Product" asp-action="Details" asp-route-id="@spotlight.Id">
                                    Découvrir
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                        <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                </a>
                            </div>
                        </div>
                    </article>
                }

                <div class="hp-float hp-float-a" aria-hidden="true">
                    <span class="hp-float-icon">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none">
                            <path d="M12 3 5 6v6c0 4.2 2.9 7.6 7 9 4.1-1.4 7-4.8 7-9V6l-7-3Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
                            <path d="m9 12 2 2 4-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </span>
                    <span><b>Garantie 12 mois</b><small>Produits officiels</small></span>
                </div>

                <div class="hp-float hp-float-b" aria-hidden="true">
                    <span class="hp-float-icon">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none">
                            <rect x="4" y="10" width="16" height="10" rx="2.4" stroke="currentColor" stroke-width="1.7" />
                            <path d="M8 10V7.5a4 4 0 0 1 8 0V10" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                        </svg>
                    </span>
                    <span><b>Paiement sécurisé</b><small>3D Secure</small></span>
                </div>
            </div>
        </div>

        <a class="hp-scroll" href="#univers" aria-label="Faire défiler vers le contenu">
            <span class="hp-scroll-line" aria-hidden="true"></span>
            Défiler
        </a>
    </section>

    @* ============================ MARQUEE ============================ *@
    <div class="hp-marquee" aria-hidden="true">
        <div class="hp-marquee-track">
            @for (var pass = 0; pass < 2; pass++)
            {
                foreach (var item in marqueeItems)
                {
                    <span class="hp-marquee-item">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                            <path d="M12 2l1.7 6.3L20 10l-6.3 1.7L12 18l-1.7-6.3L4 10l6.3-1.7z" fill="currentColor" />
                        </svg>
                        @item
                    </span>
                }
            }
        </div>
    </div>

    @* ============================ CATEGORIES ============================ *@
    <section class="hp-section" id="univers" aria-labelledby="hp-cats-title">
        <div class="tz-container">
            <header class="hp-head" data-reveal>
                <div class="hp-head-main">
                    <span class="hp-kicker">Explorer par univers</span>
                    <h2 class="hp-title" id="hp-cats-title">Trouvez votre prochain essentiel.</h2>
                    <p class="hp-lead">
                        Quatre univers complémentaires pour composer un environnement
                        technologique cohérent, pensé pour votre quotidien.
                    </p>
                </div>
                <a class="hp-link" asp-controller="Product" asp-action="Index">
                    Tout le catalogue
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </a>
            </header>

            @if (categories.Count > 0)
            {
                <div class="hp-cats">
                    @for (var i = 0; i < categories.Count; i++)
                    {
                        var category = categories[i];
                        var description = category.Description;
                        if (string.IsNullOrWhiteSpace(description))
                        {
                            description = "Une sélection soignée pour votre setup.";
                        }

                        <a class="hp-cat" asp-controller="Product" asp-action="Index" asp-route-categoryId="@category.Id"
                           data-reveal style="--d:@(i * 80)ms">
                            <span class="hp-cat-media">
                                @if (!string.IsNullOrWhiteSpace(category.ImageUrl))
                                {
                                    <img src="@category.ImageUrl" alt="@category.Name" loading="lazy" />
                                }
                                else
                                {
                                    <span class="hp-cat-fallback" aria-hidden="true">
                                        <svg viewBox="0 0 120 120" fill="none">
                                            <circle cx="60" cy="60" r="46" stroke="currentColor" stroke-width="1.4" opacity=".4" />
                                            <circle cx="60" cy="60" r="30" stroke="currentColor" stroke-width="1.4" opacity=".25" />
                                            <circle cx="60" cy="14" r="4" fill="currentColor" />
                                            <circle cx="104" cy="74" r="3" fill="currentColor" opacity=".7" />
                                            <path d="M60 30v60M30 60h60" stroke="currentColor" stroke-width="1.2" opacity=".3" />
                                        </svg>
                                    </span>
                                }
                            </span>
                            <span class="hp-cat-index" aria-hidden="true">0@(i + 1)</span>
                            <span class="hp-cat-info">
                                <span class="hp-cat-name">@category.Name</span>
                                <span class="hp-cat-desc">@description</span>
                            </span>
                            <span class="hp-cat-arrow" aria-hidden="true">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                                    <path d="M7 17 17 7M9 7h8v8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                            </span>
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="hp-empty" data-reveal>
                    <p>Le catalogue se prépare. Revenez très prochainement.</p>
                    <a class="hp-btn hp-btn-primary" asp-controller="Product" asp-action="Index">Voir le catalogue</a>
                </div>
            }
        </div>
    </section>

    @* ============================ PROMOTIONS ============================ *@
    <section class="hp-section" id="promotions" aria-labelledby="hp-promos-title">
        <div class="tz-container">
            <header class="hp-head" data-reveal>
                <div class="hp-head-main">
                    <span class="hp-kicker">Offres &amp; nouveautés</span>
                    <h2 class="hp-title" id="hp-promos-title">Des offres taillées pour vous.</h2>
                </div>
                <a class="hp-link" asp-controller="Product" asp-action="Index">
                    Toutes les offres
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </a>
            </header>

            <div class="hp-promos">
                <article class="hp-promo hp-promo-feature" data-reveal>
                    <div class="hp-promo-content">
                        <span class="hp-promo-tag">Offre de la semaine</span>
                        <h3 class="hp-promo-title">Jusqu'à <em>-20%</em> sur la sélection audio&nbsp;&amp;&nbsp;accessoires.</h3>
                        <p class="hp-promo-text">
                            Casques, claviers et chargeurs à prix réduit. Une sélection limitée,
                            à saisir tant qu'il en reste.
                        </p>

                        <div class="hp-count" data-countdown aria-label="Fin de l'offre">
                            <span class="hp-count-cell"><b data-cd="d">00</b><i>Jours</i></span>
                            <span class="hp-count-sep" aria-hidden="true">:</span>
                            <span class="hp-count-cell"><b data-cd="h">00</b><i>Heures</i></span>
                            <span class="hp-count-sep" aria-hidden="true">:</span>
                            <span class="hp-count-cell"><b data-cd="m">00</b><i>Min</i></span>
                            <span class="hp-count-sep" aria-hidden="true">:</span>
                            <span class="hp-count-cell"><b data-cd="s">00</b><i>Sec</i></span>
                        </div>

                        <a class="hp-btn hp-btn-light" asp-controller="Product" asp-action="Index">
                            Profiter de l'offre
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </a>
                    </div>

                    @if (deal is not null)
                    {
                        <div class="hp-promo-media">
                            <span class="hp-promo-badge">-20%</span>
                            <img src="@ResolveProductImage(deal.ImageUrl, deal.Name)" alt="@deal.Name" loading="lazy" />
                        </div>
                    }
                </article>

                <div class="hp-promo-side">
                    <a class="hp-promo hp-promo-mini hp-promo-new" asp-controller="Product" asp-action="Index" data-reveal style="--d:80ms">
                        <span class="hp-promo-mini-icon" aria-hidden="true">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
                                <path d="M12 2l1.7 6.3L20 10l-6.3 1.7L12 18l-1.7-6.3L4 10l6.3-1.7z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                            </svg>
                        </span>
                        <span class="hp-promo-mini-kicker">Nouveautés</span>
                        <span class="hp-promo-mini-title">Les dernières arrivées</span>
                        <span class="hp-promo-mini-cta">
                            Découvrir
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </span>
                    </a>

                    <a class="hp-promo hp-promo-mini hp-promo-gear" asp-controller="Product" asp-action="Index" data-reveal style="--d:160ms">
                        <span class="hp-promo-mini-icon" aria-hidden="true">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
                                <rect x="3" y="6" width="18" height="12" rx="2.4" stroke="currentColor" stroke-width="1.6" />
                                <path d="M7 10h6M7 14h3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                            </svg>
                        </span>
                        <span class="hp-promo-mini-kicker">Accessoires</span>
                        <span class="hp-promo-mini-title">Complétez votre setup</span>
                        <span class="hp-promo-mini-cta">
                            Explorer
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </span>
                    </a>
                </div>
            </div>
        </div>
    </section>

    @* ============================ PRODUCTS ============================ *@
    <section class="hp-section" id="selection" aria-labelledby="hp-picks-title">
        <div class="tz-container">
            <header class="hp-head" data-reveal>
                <div class="hp-head-main">
                    <span class="hp-kicker">Sélection du moment</span>
                    <h2 class="hp-title" id="hp-picks-title">Des produits pensés pour durer.</h2>
                    <p class="hp-lead">
                        Une sélection resserrée d'ordinateurs, mobiles et accessoires
                        choisis pour leur cohérence et leur qualité.
                    </p>
                </div>
                <a class="hp-link" asp-controller="Product" asp-action="Index">
                    Voir tous les produits
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </a>
            </header>

            @if (picks.Count > 0)
            {
                <div class="hp-products">
                    @for (var i = 0; i < picks.Count; i++)
                    {
                        var product = picks[i];
                        <article class="hp-card" data-reveal style="--d:@(i * 60)ms">
                            <a class="hp-card-media" asp-controller="Product" asp-action="Details" asp-route-id="@product.Id" aria-label="Voir @product.Name">
                                <img src="@ResolveProductImage(product.ImageUrl, product.Name)" alt="@product.Name" loading="lazy" decoding="async" />
                                <span class="hp-card-shine" aria-hidden="true"></span>
                                <span class="hp-card-badge @(product.IsInStock ? "is-new" : "is-out")">
                                    @(product.IsInStock ? (i == 0 ? "Coup de cœur" : "Nouveau") : "Rupture")
                                </span>
                                <span class="hp-card-quick">
                                    Voir le produit
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                        <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                </span>
                            </a>

                            <div class="hp-card-body">
                                <span class="hp-card-cat">@product.CategoryName</span>
                                <h3 class="hp-card-name">
                                    <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id">@product.Name</a>
                                </h3>
                                <div class="hp-card-rating" aria-label="Note 4.8 sur 5">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                        <path d="m12 3 2.7 5.9 6.3.7-4.7 4.3 1.3 6.2L12 17.9 6.4 20.4l1.3-6.2L3 9.9l6.3-.7z" />
                                    </svg>
                                    <span>4.8</span>
                                    <i>·</i>
                                    <span class="hp-card-stock">@(product.IsInStock ? "En stock" : "Indisponible")</span>
                                </div>
                                <div class="hp-card-foot">
                                    <span class="hp-card-price">@product.Price.ToString("N2") €</span>
                                    <a class="hp-card-arrow" asp-controller="Product" asp-action="Details" asp-route-id="@product.Id" aria-label="Détails de @product.Name">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                            <path d="M7 17 17 7M9 7h8v8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                        </svg>
                                    </a>
                                </div>
                            </div>
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="hp-empty" data-reveal>
                    <p>La sélection se prépare. Revenez prochainement.</p>
                    <a class="hp-btn hp-btn-primary" asp-controller="Product" asp-action="Index">Explorer le catalogue</a>
                </div>
            }
        </div>
    </section>

    @* ============================ STORY ============================ *@
    <section class="hp-story" aria-labelledby="hp-story-title">
        <div class="tz-container">
            <div class="hp-story-inner">
                <div class="hp-story-copy" data-reveal>
                    <span class="hp-kicker hp-kicker-light">La maison TechZone</span>
                    <h2 class="hp-story-title" id="hp-story-title">Choisir mieux.<br />Vivre mieux.</h2>
                    <p class="hp-story-text">
                        Nous réunissons des équipements qui se complètent : une machine pour créer,
                        un mobile pour rester connecté, des accessoires pour affiner l'expérience.
                        Une sélection lisible, sans superflu — et un service à la hauteur.
                    </p>
                    <ul class="hp-story-list">
                        <li>
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <path d="m5 12 4 4L19 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                            Produits authentiques, garantis et suivis
                        </li>
                        <li>
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <path d="m5 12 4 4L19 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                            Conseil personnalisé par des experts
                        </li>
                        <li>
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <path d="m5 12 4 4L19 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                            Livraison rapide partout en Tunisie
                        </li>
                    </ul>
                    <a class="hp-btn hp-btn-light" asp-controller="Product" asp-action="Index">
                        Parcourir le catalogue
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </a>
                </div>

                <div class="hp-story-stats" data-reveal style="--d:120ms">
                    <div class="hp-stat">
                        <b data-count="120" data-suffix="+">120+</b>
                        <span>Références sélectionnées</span>
                    </div>
                    <div class="hp-stat">
                        <b data-count="10" data-suffix="k+">10k+</b>
                        <span>Clients satisfaits</span>
                    </div>
                    <div class="hp-stat">
                        <b data-count="4.9" data-decimals="1">4.9</b>
                        <span>Note moyenne / 5</span>
                    </div>
                    <div class="hp-stat">
                        <b data-count="12" data-suffix=" mois">12</b>
                        <span>Garantie officielle</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    @* ============================ FAQ ============================ *@
    <section class="hp-section" aria-labelledby="hp-faq-title">
        <div class="tz-container home-faq-grid">
            <div class="home-faq-head" data-reveal>
                <span class="hp-kicker">Questions fréquentes</span>
                <h2 class="hp-title" id="hp-faq-title">Vous avez une question ?</h2>
                <p class="hp-lead">Quelques réponses pour vous aider à choisir en toute confiance.</p>
            </div>

            <div class="home-faq-list" data-reveal style="--d:80ms">
                <div class="home-faq-item">
                    <button class="home-faq-trigger" type="button" aria-expanded="false" aria-controls="faq-panel-1">
                        Comment trouver un produit sur TechZone ?
                        <span class="home-faq-icon" aria-hidden="true"></span>
                    </button>
                    <div class="home-faq-panel" id="faq-panel-1" role="region">
                        <p class="home-faq-panel-inner">
                            Utilisez la barre de recherche en haut de page pour saisir un nom de produit,
                            ou parcourez le catalogue puis affinez les résultats par catégorie et par prix.
                        </p>
                    </div>
                </div>

                <div class="home-faq-item">
                    <button class="home-faq-trigger" type="button" aria-expanded="false" aria-controls="faq-panel-2">
                        Comment choisir un ordinateur adapté à mes besoins ?
                        <span class="home-faq-icon" aria-hidden="true"></span>
                    </button>
                    <div class="home-faq-panel" id="faq-panel-2" role="region">
                        <p class="home-faq-panel-inner">
                            Chaque fiche produit détaille la configuration : processeur, mémoire, stockage
                            et taille d'écran. Comparez ces informations selon votre usage — mobilité,
                            création ou multitâche — pour trouver le modèle le plus cohérent.
                        </p>
                    </div>
                </div>

                <div class="home-faq-item">
                    <button class="home-faq-trigger" type="button" aria-expanded="false" aria-controls="faq-panel-3">
                        Quels types de produits puis-je découvrir ?
                        <span class="home-faq-icon" aria-hidden="true"></span>
                    </button>
                    <div class="home-faq-panel" id="faq-panel-3" role="region">
                        <p class="home-faq-panel-inner">
                            TechZone regroupe des ordinateurs portables, des smartphones, des écrans
                            et des accessoires. Chaque catégorie est accessible depuis le menu
                            ou directement depuis la page d'accueil.
                        </p>
                    </div>
                </div>

                <div class="home-faq-item">
                    <button class="home-faq-trigger" type="button" aria-expanded="false" aria-controls="faq-panel-4">
                        Comment suivre mes commandes ?
                        <span class="home-faq-icon" aria-hidden="true"></span>
                    </button>
                    <div class="home-faq-panel" id="faq-panel-4" role="region">
                        <p class="home-faq-panel-inner">
                            Une fois connecté, ouvrez votre compte puis « Mes commandes »
                            pour consulter l'historique et le détail de vos commandes.
                        </p>
                    </div>
                </div>

                <div class="home-faq-item">
                    <button class="home-faq-trigger" type="button" aria-expanded="false" aria-controls="faq-panel-5">
                        Ai-je besoin d'un compte pour commander ?
                        <span class="home-faq-icon" aria-hidden="true"></span>
                    </button>
                    <div class="home-faq-panel" id="faq-panel-5" role="region">
                        <p class="home-faq-panel-inner">
                            Oui. La création d'un compte est nécessaire pour ajouter des produits
                            au panier et finaliser une commande. Vous pouvez vous connecter
                            ou créer un compte depuis le menu Compte.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    @* ============================ NEWSLETTER CTA ============================ *@
    <section class="hp-section hp-cta-section" aria-labelledby="hp-cta-title">
        <div class="tz-container">
            <div class="hp-cta" data-reveal>
                <div class="hp-cta-copy">
                    <span class="hp-kicker hp-kicker-light">Le cercle TechZone</span>
                    <h2 class="hp-cta-title" id="hp-cta-title">Restez à la pointe.</h2>
                    <p class="hp-cta-text">
                        Nouveautés, offres privées et conseils d'experts — l'essentiel,
                        une fois par mois. Pas de spam.
                    </p>
                </div>

                <form class="hp-news" data-news novalidate>
                    <div class="hp-news-field">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <rect x="3" y="5" width="18" height="14" rx="2.5" stroke="currentColor" stroke-width="1.7" />
                            <path d="m4 7 8 6 8-6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                        <input type="email" name="email" placeholder="Votre adresse e-mail" aria-label="Votre adresse e-mail" required />
                        <button type="submit">
