@model OrderConfirmationViewModel
@{
    ViewData["Title"] = "Confirmation de commande";
}

<div class="text-center py-4">
    <div class="display-6 mb-2">Merci pour votre commande</div>
    <p class="lead text-muted mb-0">Votre commande a bien été enregistrée.</p>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-4">
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="text-muted small">Numéro de commande</div>
                <div class="fs-5 fw-bold">@Model.OrderNumber</div>
            </div>
            <div class="col-md-4">
                <div class="text-muted small">Date</div>
                <div class="fw-semibold">@Model.OrderDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
            </div>
            <div class="col-md-4">
                <div class="text-muted small">Statut</div>
                <span class="badge text-bg-success">@Model.StatusLabel</span>
            </div>
        </div>

        <h2 class="h5 mb-3">Produits commandés</h2>
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th scope="col">Produit</th>
                        <th scope="col" class="text-end">Prix unitaire</th>
                        <th scope="col" class="text-center">Quantité</th>
                        <th scope="col" class="text-end">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.ProductName</td>
                            <td class="text-end">@item.UnitPrice.ToString("N2") €</td>
                            <td class="text-center">@item.Quantity</td>
                            <td class="text-end fw-semibold">@item.LineTotal.ToString("N2") €</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th colspan="3" class="text-end fs-5">Total</th>
                        <th class="text-end fs-5">@Model.TotalAmount.ToString("N2") €</th>
                    </tr>
                </tfoot>
            </table>
        </div>

        <div class="row g-4 mt-2">
            <div class="col-md-6">
                <h2 class="h5 mb-2">Adresse d'expédition</h2>
                <address class="mb-0">
                    <strong>@Model.ShippingFullName</strong><br />
                    @Model.ShippingAddress<br />
                    @Model.ShippingPostalCode @Model.ShippingCity<br />
                    @Model.ShippingCountry<br />
                    Tél. : @Model.ShippingPhone
                </address>
            </div>
            <div class="col-md-6">
                <h2 class="h5 mb-2">Paiement</h2>
                <p class="mb-1">@Model.PaymentMethodLabel</p>
                <span class="badge text-bg-warning">@Model.PaymentStatusLabel</span>
                <p class="text-muted small mt-2 mb-0">
                    Aucun paiement en ligne n'a été effectué. Le règlement se fera à la livraison.
                </p>
            </div>
        </div>
    </div>
</div>

<div class="d-flex flex-wrap gap-2">
    <a asp-controller="Product" asp-action="Index" class="btn btn-primary">Continuer mes achats</a>
    <a asp-controller="Order" asp-action="History" class="btn btn-outline-primary">Voir mes commandes</a>
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Retour à l'accueil</a>
</div>
