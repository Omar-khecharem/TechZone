@model CheckoutViewModel
@{
    ViewData["Title"] = "Validation de la commande";
}

<div style="max-width: 1200px; margin: 2rem auto; padding: 1rem 1rem 2rem;">
    <h1 style="margin-bottom: 0.5rem;">Validation de la commande</h1>
    <p style="color: #6c7573; margin-bottom: 1rem;">Vérifiez vos informations avant de confirmer.</p>

    <a asp-controller="Cart" asp-action="Index" style="background: #6c7573; color: white; border: none; padding: 0.5rem 1rem; border-radius: 0.25rem; text-decoration: none;">Retour au panier</a>

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div style="background: #f8d7da; border: 1px solid #f5c6cb; border-radius: 0.375rem; padding: 0.75rem 1rem; margin-bottom: 1rem; font-size: 0.875rem;">@errorMessage</div>
    }

    <form action="" method="post" style="max-width: 1200px;">
        <div style="margin-bottom: 1rem;">
            <label style="display: block; font-size: 0.875rem; margin-bottom: 0.25rem;">Nom complet</label>
            <input style="width: 100%; padding: 0.375rem; border: 1px solid #ccc; border-radius: 0.25rem; margin-bottom: 0.5rem;" asp-for="FullName" />
            <span style="color: #dc3545; font-size: 0.875rem; display: block;" asp-validation-for="FullName"></span>
        </div>

        <div style="margin-bottom: 1rem; display: flex; gap: 0.5rem;">
            <div style="flex: 0 0 45%; max-width: 45%;">
                <label style="display: block; font-size: 0.875rem; margin-bottom: 0.25rem;">Téléphone</label>
                <input style="width: 100%; padding: 0.375rem; border: 1px solid #ccc; border-radius: 0.25rem;" asp-for="Phone" />
            </div>
            <div style="flex: 0 0 45%; max-width: 45%;">
                <label style="display: block; font-size: 0.875rem; margin-bottom: 0.25rem;">Adresse</label>
                <input style="width: 100%; padding: 0.375rem; border: 1px solid #ccc; border-radius: 0.25rem;" asp-for="Address" />
            </div>
        </div>

        <div style="margin-bottom: 1rem; display: flex; gap: 0.5rem;">
            <div style="flex: 0 0 30%; max-width: 30%;">
                <label style="display: block; font-size: 0.875rem; margin-bottom: 0.25rem;">Ville</label>
                <input style="width: 100%; padding: 0.375rem; border: 1px solid #ccc; border-radius: 0.25rem;" asp-for="City" />
            </div>
            <div style="flex: 0 0 20%; max-width: 20%;">
                <label style="display: block; font-size: 0.875rem; margin-bottom: 0.25rem;">Code postal</label>
                <input style="width: 100%; padding: 0.375rem; border: 1px solid #ccc; border-radius: 0.25rem;" asp-for="PostalCode" />
            </div>
            <div style="flex: 0 0 25%; max-width: 25%;">
                <label style="display: block; font-size: 0.875rem; margin-bottom: 0.25rem;">Pays</label>
                <input style="width: 100%; padding: 0.375rem; border: 1px solid #ccc; border-radius: 0.25rem;" asp-for="Country" />
            </div>
        </div>

        <hr style="margin: 1rem 0; border: 0; border-top: 1px solid #dee2e9;" />

        <div style="margin-bottom: 1rem; font-size: 0.875rem;">
            <div style="display: flex; justify-content: between; align-items: center; margin-bottom: 0.5rem;">
                <div>Paiement</div>
                <span style="display: inline-block; background: #ffc107; color: #000; padding: 0.25rem 0.5rem; border-radius: 0.25rem; font-size: 0.75rem;">En attente</span>
            </div>

            <div style="display: flex; flex-wrap: wrap; justify-content: between; gap: 0.5rem;">
                <div style="flex: 0 0 30%; max-width: 30%; font-size: 0.875rem;">Paiement à la livraison</div>
                <div style="flex: 0 0 70%; max-width: 70%; background: #f8f9fa; padding: 0.75rem; border-radius: 0.375rem;">Aucun paiement en ligne n'est effectué. Le montant sera réglé à la réception.</div>
            </div>
        </div>

        <div style="max-width: 1200px; margin: 2rem auto; display: flex; gap: 0.5rem; justify-content: flex-end;">
            <button type="submit" style="padding: 0.5rem 1rem; background: #007bff; color: white; border: none; border-radius: 0.25rem; cursor: pointer; font-size: 0.875rem;">Confirmer la commande</button>
            <p style="color: #6c7573; font-size: 0.75rem; margin: 0;">Le stock et le total seront vérifiés à nouveau lors de la confirmation.</p>
        </div>
    </form>
</div>