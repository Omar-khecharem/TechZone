@model OrderDetailsViewModel
@{
    ViewData["Title"] = "Détails de la commande";
}

<nav aria-label="Fil d'Ariane" class="mb-3">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a asp-action="History">Mes commandes</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.OrderNumber</li>
    </ol>
</nav>

<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-4">
    <div>
        <h1 class="h2 mb-1">Détails de la commande</h1>
        <p class="text-muted mb-0">@Model.OrderNumber</p>
    </div>
    <a asp-action="History" class="btn btn-outline-secondary">Retour à mes commandes</a>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-4">
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="text-muted small">Numéro</div>
                <div class="fw-semibold">@Model.OrderNumber</div>
            </div>
            <div class="col-md-3">
                <div class="text-muted small">Date</div>
                <div class="fw-semibold">@Model.OrderDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
            </div>
            <div class="col-md-3">
                <div class="text-muted small">Statut</div>
                <span class="badge text-bg-light border">@Model.StatusLabel</span>
            </div>
            <div class="col-md-3">
                <div class="text-muted small">Paiement</div>
                <div class="fw-semibold">@Model.PaymentMethodLabel</div>
                <span class="badge text-bg-warning">@Model.PaymentStatusLabel</span>
            </div>
        </div>

        <h2 class="h5 mb-3">Produits commandés</h2>
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th scope="col">Produit</th>
                        <th scope="col" class="text-end">Prix unitaire</th>
                        <th scope="col" class="text-center">Quantité</th>
                        <th scope="col" class="text-end">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.ProductName</td>
                            <td class="text-end">@item.UnitPrice.ToString("N2") €</td>
                            <td class="text-center">@item.Quantity</td>
                            <td class="text-end fw-semibold">@item.LineTotal.ToString("N2") €</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th colspan="3" class="text-end fs-5">Total</th>
                        <th class="text-end fs-5">@Model.TotalAmount.ToString("N2") €</th>
                    </tr>
                </tfoot>
            </table>
        </div>

        <div class="row g-4 mt-2">
            <div class="col-md-6">
                <h2 class="h5 mb-2">Adresse d'expédition</h2>
                <address class="mb-0">
                    <strong>@Model.ShippingFullName</strong><br />
                    @Model.ShippingAddress<br />
                    @Model.ShippingPostalCode @Model.ShippingCity<br />
                    @Model.ShippingCountry<br />
                    Tél. : @Model.ShippingPhone
                </address>
            </div>
            <div class="col-md-6">
                <h2 class="h5 mb-2">Paiement</h2>
                <p class="mb-1">@Model.PaymentMethodLabel</p>
                <span class="badge text-bg-warning">@Model.PaymentStatusLabel</span>
                <p class="text-muted small mt-2 mb-0">
                    Aucun paiement en ligne n'a été effectué. Le règlement se fait à la livraison.
                </p>
            </div>
        </div>
    </div>
</div>
