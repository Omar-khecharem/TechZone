@model OrderDetailsViewModel
@{
    ViewData["Title"] = "Détails de la commande";
}

<nav aria-label="Fil d'Ariane" style="margin-bottom: 1rem;">
    <ol style="display: flex; margin: 0; padding: 0; list-style: none; gap: 1rem;">
        <li style="display: inline;"><a asp-action="History" style="color: #333; text-decoration: none;">Mes commandes</a></li>
        <li style="color: #6c7573;">@Model.OrderNumber</li>
    </ol>
</nav>

<div style="max-width: 1200px; margin: 1rem auto; margin-bottom: 1rem;">
    <div style="display: flex; justify-content-between; align-items: end; margin-bottom: 0.5rem;">
        <div>
            <h1 style="font-size: 1.5rem;">Détails de la commande</h1>
            <p style="color: #6c7573; margin: 0;">@Model.OrderNumber</p>
        </div>
        <a href="#" style="font-size: 0.875rem; color: #007bff; text-decoration: none;">Retour à mes commandes</a>
    </div>
</div>

<div style="background: #fff; border: 1px solid #dee2e9; border-radius: 0.375rem; padding: 1rem; margin: 0 auto; max-width: 1200px;">
    <div style="display: flex; flex-wrap: wrap; gap: 1rem; margin: 0 0 0.5rem;">
        <div style="flex: 0 0 22%; max-width: 22%; font-size: 0.875rem; color: #6c7573;">Numéro</div>
        <div style="flex: 0 0 22%; max-width: 22%; font-weight: bold;">@Model.OrderNumber</div>
        <div style="flex: 0 0 22%; max-width: 22%; font-size: 0.875rem; color: #6c7573;">Date</div>
        <div style="flex: 0 0 22%; max-width: 22%; font-weight: bold;">@Model.OrderDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
        <div style="flex: 0 0 22%; max-width: 22%; font-size: 0.875rem; color: #6c7573;">Statut</div>
        <div style="flex: 0 0 22%; max-width: 22%; font-weight: bold;">@Model.StatusLabel</div>
        <div style="flex: 0 0 22%; max-width: 22%; font-size: 0.875rem; color: #6c7573;">Paiement</div>
        <div style="flex: 0 0 22%; max-width: 22%; font-weight: bold;">@Model.PaymentMethodLabel</div>
        <div style="flex: 0 0 22%; max-width: 22%; font-size: 0.875rem; color: #6c7573;">Paiement statut</div>
        <div style="flex: 0 0 22%; max-width: 22%; font-weight: bold;">@Model.PaymentStatusLabel</div>
    </div>

    <h2 style="font-size: 1.25rem; margin: 0.5rem 0;">Produits commandés</h2>
    <div style="overflow-x: auto;">
        <table style="width: 100%; border-collapse: collapse; font-size: 0.875rem;">
            <thead style="background: #f8f9fa; border-bottom: 1px solid #dee2e9;">
                <tr>
                    <th scope="col" style="padding: 0.5rem;">Produit</th>
                    <th scope="col" style="padding: 0.5rem; text-align: end;">Prix unitaire</th>
                    <th scope="col" style="padding: 0.5rem; text-align: center;">Quantité</th>
                    <th scope="col" style="padding: 0.5rem; text-align: end;">Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr style="border-bottom: 1px solid #eee;">
                        <td style="padding: 0.5rem;">@item.ProductName</td>
                        <td style="padding: 0.5rem; text-align: end;">@item.UnitPrice.ToString("N2") €</td>
                        <td style="padding: 0.5rem; text-align: center;">@item.Quantity</td>
                        <td style="padding: 0.5rem; text-align: end;">@item.LineTotal.ToString("N2") €</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div style="max-width: 1200px; margin: 1rem auto; display: flex; gap: 1rem;">
    <div style="flex: 0 0 48%; max-width: 48%; font-size: 0.875rem;">
        <h2>Adresse d'expédition</h2>
        <address style="font-size: 0.875rem; line-height: 1.5;">
            <strong>@Model.ShippingFullName</strong><br />
            @Model.ShippingAddress<br />
            @Model.ShippingPostalCode @Model.ShippingCity<br />
            @Model.ShippingCountry<br />
            Tél. : @Model.ShippingPhone
        </address>
    </div>
    <div style="flex: 0 0 48%; max-width: 48%; font-size: 0.875rem;">
        <h2>Paiement</h2>
        <p style="margin-bottom: 0.25rem;">@Model.PaymentMethodLabel</p>
        <span style="display: inline-block; background: #ffc107; color: #000; padding: 0.25rem 0.5rem; border-radius: 0.25rem; font-size: 0.75rem;">@Model.PaymentStatusLabel</span>
        <p style="color: #6c7573; font-size: 0.75rem; margin: 0.25rem 0;">Aucun paiement en ligne n'a été effectué. Le règlement se fait à la livraison.</p>
    </div>
</div>
