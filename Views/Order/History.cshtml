@model OrderHistoryViewModel
@{
    ViewData["Title"] = "Mes commandes";
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-4">
    <div>
        <h1 class="h2 mb-1">Mes commandes</h1>
        @if (!Model.IsEmpty)
        {
            <p class="text-muted mb-0">
                @Model.TotalCount commande(s) au total.
            </p>
        }
    </div>
    <a asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary">Continuer mes achats</a>
</div>

@if (Model.IsEmpty)
{
    <div class="text-center border rounded bg-white py-5">
        <h2 class="h4">Aucune commande pour le moment</h2>
        <p class="text-muted">Vous n'avez encore passé aucune commande.</p>
        <a asp-controller="Product" asp-action="Index" class="btn btn-primary">Découvrir le catalogue</a>
    </div>
}
else
{
    <div class="table-responsive bg-white border rounded shadow-sm">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th scope="col">Numéro</th>
                    <th scope="col">Date</th>
                    <th scope="col" class="text-end">Montant total</th>
                    <th scope="col">Statut</th>
                    <th scope="col"><span class="visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model.Orders)
                {
                    <tr>
                        <td>
                            <a class="fw-semibold text-decoration-none"
                               asp-action="Details"
                               asp-route-id="@order.Id">@order.OrderNumber</a>
                        </td>
                        <td>@order.OrderDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="text-end fw-semibold">@order.TotalAmount.ToString("N2") €</td>
                        <td><span class="badge text-bg-light border">@order.StatusLabel</span></td>
                        <td class="text-end">
                            <a asp-action="Details"
                               asp-route-id="@order.Id"
                               class="btn btn-sm btn-outline-primary">Détails</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Pagination des commandes" class="mt-4">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                    <a class="page-link" asp-action="History" asp-route-page="@(Model.Page - 1)">Précédent</a>
                </li>
                @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                {
                    <li class="page-item @(pageNumber == Model.Page ? "active" : "")">
                        <a class="page-link" asp-action="History" asp-route-page="@pageNumber">@pageNumber</a>
                    </li>
                }
                <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                    <a class="page-link" asp-action="History" asp-route-page="@(Model.Page + 1)">Suivant</a>
                </li>
            </ul>
        </nav>
    }
}
