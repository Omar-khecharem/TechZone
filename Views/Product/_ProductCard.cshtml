@model ProductCardViewModel

<div class="card h-100 border-0 shadow-sm product-card">
    <a asp-controller="Product" asp-action="Details" asp-route-id="@Model.Id">
        <img src="@Model.ImageUrl" class="card-img-top product-card-image" alt="@Model.Name" loading="lazy" />
    </a>
    <div class="card-body d-flex flex-column">
        <p class="text-uppercase text-muted small mb-1">@Model.CategoryName</p>
        <h2 class="h5 card-title">
            <a class="text-decoration-none text-dark" asp-controller="Product" asp-action="Details" asp-route-id="@Model.Id">
                @Model.Name
            </a>
        </h2>
        <div class="mt-auto d-flex justify-content-between align-items-center pt-3">
            <span class="fs-5 fw-bold">@Model.Price.ToString("N2") €</span>
            <a class="btn btn-sm btn-outline-primary" asp-controller="Product" asp-action="Details" asp-route-id="@Model.Id">
                Voir le produit
            </a>
        </div>
    </div>
</div>
