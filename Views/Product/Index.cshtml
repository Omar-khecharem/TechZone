@model CatalogViewModel
@{
    ViewData["Title"] = "Catalogue";
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-4">
    <div>
        <h1 class="h2 mb-1">Catalogue</h1>
        <p class="text-muted mb-0">Découvrez nos produits high-tech.</p>
    </div>
    <span class="text-muted">@Model.Products.TotalCount produit(s)</span>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-3 align-items-end">
            <div class="col-md-4 col-lg-3">
                <label for="q" class="form-label">Recherche</label>
                <input id="q" name="q" value="@Model.SearchTerm" class="form-control" placeholder="Nom du produit" />
            </div>

            <div class="col-md-4 col-lg-3">
                <label for="categoryId" class="form-label">Catégorie</label>
                <select id="categoryId" name="categoryId" class="form-select">
                    <option value="">Toutes les catégories</option>
                    @foreach (var category in Model.Categories)
                    {
                        <option value="@category.Id" selected="@(Model.CategoryId == category.Id ? "selected" : null)">
                            @category.Name
                        </option>
                    }
                </select>
            </div>

            <div class="col-6 col-md-2">
                <label for="minPrice" class="form-label">Prix minimum</label>
                <input id="minPrice" name="minPrice" value="@Model.MinPrice" class="form-control" inputmode="decimal" placeholder="0" />
            </div>

            <div class="col-6 col-md-2">
                <label for="maxPrice" class="form-label">Prix maximum</label>
                <input id="maxPrice" name="maxPrice" value="@Model.MaxPrice" class="form-control" inputmode="decimal" placeholder="2000" />
            </div>

            <div class="col-md-12 col-lg-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">Filtrer</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Réinitialiser</a>
            </div>
        </form>
    </div>
</div>

<div asp-validation-summary="All" class="text-danger mb-3"></div>

@if (Model.Products.Items.Count == 0)
{
    <div class="text-center border rounded bg-white py-5">
        <p class="fs-5 mb-2">Aucun produit ne correspond à votre recherche.</p>
        <a asp-action="Index" class="btn btn-outline-primary">Réinitialiser les filtres</a>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
        @foreach (var product in Model.Products.Items)
        {
            <div class="col">
                <partial name="_ProductCard" model="product" />
            </div>
        }
    </div>

    @if (Model.Products.TotalPages > 1)
    {
        <nav aria-label="Pagination du catalogue" class="mt-4">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.Products.HasPreviousPage ? string.Empty : "disabled")">
                    @if (Model.Products.HasPreviousPage)
                    {
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-q="@Model.SearchTerm"
                           asp-route-categoryId="@Model.CategoryId"
                           asp-route-minPrice="@Model.MinPrice"
                           asp-route-maxPrice="@Model.MaxPrice"
                           asp-route-page="@(Model.Products.Page - 1)">Précédent</a>
                    }
                    else
                    {
                        <span class="page-link">Précédent</span>
                    }
                </li>

                @for (var pageNumber = 1; pageNumber <= Model.Products.TotalPages; pageNumber++)
                {
                    <li class="page-item @(pageNumber == Model.Products.Page ? "active" : string.Empty)">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-q="@Model.SearchTerm"
                           asp-route-categoryId="@Model.CategoryId"
                           asp-route-minPrice="@Model.MinPrice"
                           asp-route-maxPrice="@Model.MaxPrice"
                           asp-route-page="@pageNumber">@pageNumber</a>
                    </li>
                }

                <li class="page-item @(Model.Products.HasNextPage ? string.Empty : "disabled")">
                    @if (Model.Products.HasNextPage)
                    {
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-q="@Model.SearchTerm"
                           asp-route-categoryId="@Model.CategoryId"
                           asp-route-minPrice="@Model.MinPrice"
                           asp-route-maxPrice="@Model.MaxPrice"
                           asp-route-page="@(Model.Products.Page + 1)">Suivant</a>
                    }
                    else
                    {
                        <span class="page-link">Suivant</span>
                    }
                </li>
            </ul>
            <p class="text-center text-muted small">Page @Model.Products.Page sur @Model.Products.TotalPages</p>
        </nav>
    }
}
