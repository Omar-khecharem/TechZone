@model ProductDetailsViewModel
@{
    ViewData["Title"] = Model.Name;
}

<nav aria-label="Fil d'Ariane" style="margin-bottom: 1rem;">
    <ol style="margin: 0; padding: 0; list-style: none;">
        <li style="display: inline; margin-right: 1rem;"><a asp-action="Index" style="color: #333; text-decoration: none;">Catalogue</a></li>
        <li style="display: inline; color: #6c7573;">@Model.Name</li>
    </ol>
</nav>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div style="background: #d4edda; border: 1px solid #c3e6cb; border-radius: 0.375rem; padding: 0.75rem 1rem; margin: 0.5rem 0;">
        <span style="font-size: 0.875rem;">@successMessage</span>
        <a asp-controller="Cart" asp-action="Index" style="color: #155724; text-decoration: underline;">Voir le panier</a>
    </div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div style="background: #f8d7da; border: 1px solid #f5c6cb; border-radius: 0.375rem; padding: 0.75rem 1rem; margin: 0.5rem 0;">
        <span style="font-size: 0.875rem;">@errorMessage</span>
    </div>
}

<div style="margin: 1rem 0;">
    <div style="display: flex; gap: 1rem; align-items: start;">
        <div style="flex: 0 0 45%; max-width: 45%;">
            <img src="@Model.ImageUrl" alt="@Model.Name" style="width: 100%; height: auto; border-radius: 0.375rem;" />
        </div>

        <div style="flex: 0 0 55%; max-width: 55%;">
            <span style="display: inline-block; background: #6c7573; color: white; padding: 0.25rem 0.5rem; border-radius: 0.25rem; font-size: 0.75rem; margin-bottom: 0.5rem;">@Model.CategoryName</span>

            <h1 style="font-size: 1.5rem; margin: 0 0 0.5rem;">@Model.Name</h1>
            <p style="font-size: 1.5rem; font-weight: bold; margin: 0;">@Model.Price.ToString("N2") €</p>
            <p style="font-size: 0.875rem; margin: 0.25rem 0;">@Model.Description</p>

            @if (Model.IsInStock)
            {
                <p style="color: #155724; margin: 0;">En stock : @Model.Stock</p>
            }
            else
            {
                <p style="color: #dc3545; margin: 0;">Rupture de stock</p>
            }

            <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.5rem;">
                @if (!Model.IsInStock)
                {
                    <button style="padding: 0.375rem 0.5rem; background: #6c7573; color: white; border: none; border-radius: 0.25rem; cursor: not-allowed; font-size: 0.875rem;">Rupture de stock</button>
                }
                else if (User.Identity?.IsAuthenticated == true)
                {
                    <form asp-controller="Cart" asp-action="Add" method="post" style="display: inline;">
                        <button type="submit" style="padding: 0.375rem 0.5rem; background: #007bff; color: white; border: none; border-radius: 0.25rem; cursor: pointer; font-size: 0.875rem;">Ajouter au panier</button>
                    </form>
                }
                else
                {
                    <a href="#" style="padding: 0.375rem 0.5rem; background: #007bff; color: white; border: none; border-radius: 0.25rem; text-decoration: none; font-size: 0.875rem;">Se connecter pour ajouter au panier</a>
                }

                <a asp-action="Index" style="padding: 0.375rem 0.5rem; background: #6c7573; color: white; border: none; border-radius: 0.25rem; text-decoration: none; font-size: 0.875rem;">Retour au catalogue</a>
            </div>
        </div>
    </div>
</div>
