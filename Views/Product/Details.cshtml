@model ProductDetailsViewModel
@{
    ViewData["Title"] = Model.Name;
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var stockLabel = Model.IsInStock
        ? (Model.Stock == 1 ? "1 unité disponible" : $"{Model.Stock} unités disponibles")
        : "Rupture de stock";
}

<div class="pd-page">
    <div class="tz-container">
        <nav class="pd-breadcrumb" aria-label="Fil d'Ariane">
            <ol>
                <li><a asp-controller="Home" asp-action="Index">Accueil</a></li>
                <li><a asp-action="Index">Catalogue</a></li>
                <li><span>@Model.CategoryName</span></li>
                <li><span aria-current="page">@Model.Name</span></li>
            </ol>
        </nav>

        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="pd-alert is-success" role="status">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="m5 12 4.2 4.2L19 6.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <p>@successMessage <a asp-controller="Cart" asp-action="Index">Voir le panier</a></p>
            </div>
        }

        @if (TempData["ErrorMessage"] is string errorMessage)
        {
            <div class="pd-alert is-error" role="alert">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2" />
                    <path d="M12 7.5v5.5M12 16.5h.01" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
                </svg>
                <p>@errorMessage</p>
            </div>
        }

        <div class="pd-layout">
            <div class="pd-media">
                <div class="pd-media-frame">
                    <span class="pd-media-tag">Réf. TZ-@Model.Id.ToString("D4")</span>
                    <img src="@Model.ImageUrl" alt="@Model.Name" fetchpriority="high" decoding="async" />
                </div>
                <p class="pd-media-note">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M12 3.5 5 6.5v5.2c0 4.2 2.9 7.4 7 8.8 4.1-1.4 7-4.6 7-8.8V6.5l-7-3Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
                        <path d="m9 12 2 2 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    Visuel non contractuel
                </p>
            </div>

            <div class="pd-info">
                <span class="pd-cat">@Model.CategoryName</span>
                <h1 class="pd-title">@Model.Name</h1>

                <div class="pd-price-row">
                    <div class="pd-price-main">
                        <span class="pd-price">@Model.Price.ToString("N2") TND</span>
                        <span class="pd-price-note">TTC</span>
                    </div>
                    <span class="pd-stock @(Model.IsInStock ? "is-in" : "is-out")">
                        <span class="pd-stock-dot" aria-hidden="true"></span>
                        @stockLabel
                    </span>
                </div>

                <dl class="pd-meta">
                    <div>
                        <dt>Référence</dt>
                        <dd>TZ-@Model.Id.ToString("D4")</dd>
                    </div>
                    <div>
                        <dt>Catégorie</dt>
                        <dd>@Model.CategoryName</dd>
                    </div>
                    <div>
                        <dt>Disponibilité</dt>
                        <dd>@(Model.IsInStock ? $"{Model.Stock} en stock" : "Épuisé")</dd>
                    </div>
                </dl>

                <div class="pd-actions">
                    @if (!Model.IsInStock)
                    {
                        <button class="pd-btn pd-btn-primary" type="button" disabled>Rupture de stock</button>
                    }
                    else if (isAuthenticated)
                    {
                        <form class="pd-add-form" asp-controller="Cart" asp-action="Add" method="post">
                            <input type="hidden" name="productId" value="@Model.Id" />
                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                            <button class="pd-btn pd-btn-primary" type="submit">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                    <path d="M6 8h12l-1 12H7L6 8Z" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round" />
                                    <path d="M9 8V6a3 3 0 0 1 6 0v2" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" />
                                </svg>
                                Ajouter au panier
                            </button>
                        </form>
                    }
                    else
                    {
                        <a class="pd-btn pd-btn-primary" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnUrl">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <circle cx="12" cy="8" r="3.6" stroke="currentColor" stroke-width="1.9" />
                                <path d="M5 20c1.3-3.5 4-5.2 7-5.2s5.7 1.7 7 5.2" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" />
                            </svg>
                            Se connecter pour acheter
                        </a>
                    }

                    <a class="pd-btn pd-btn-secondary" asp-action="Index">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <path d="M19 12H5M11 6l-6 6 6 6" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                        Retour au catalogue
                    </a>
                </div>

                <p class="pd-note">Prix TTC. Disponibilité mise à jour en temps réel.</p>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <section class="pd-description" aria-labelledby="pd-description-title">
                <div>
                    <span class="pd-kicker">Fiche produit</span>
                    <h2 id="pd-description-title">Description</h2>
                </div>
                <div class="pd-description-body">
                    <p>@Model.Description</p>
                </div>
            </section>
        }
    </div>
</div>
