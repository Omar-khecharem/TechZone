@model ProfileViewModel
@{
    ViewData["Title"] = "Mon profil";

    var firstInitial = string.IsNullOrWhiteSpace(Model.FirstName) ? string.Empty : Model.FirstName.Trim().Substring(0, 1);
    var lastInitial = string.IsNullOrWhiteSpace(Model.LastName) ? string.Empty : Model.LastName.Trim().Substring(0, 1);
    var initials = (firstInitial + lastInitial).ToUpperInvariant();
    if (string.IsNullOrEmpty(initials))
    {
        initials = "TZ";
    }

    var fullName = $"{Model.FirstName} {Model.LastName}".Trim();
    if (string.IsNullOrWhiteSpace(fullName))
    {
        fullName = "Membre TechZone";
    }
}

<div class="shop-page account-page">
    <div class="tz-container">
        <nav class="cat-breadcrumb" aria-label="Fil d'Ariane">
            <a asp-controller="Home" asp-action="Index">Accueil</a>
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="m9 6 6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span>Mon profil</span>
        </nav>

        <header class="shop-head">
            <div>
                <span class="shop-eyebrow">Espace membre</span>
                <h1 class="shop-title">Mon profil</h1>
                <p class="shop-lead">Gérez vos informations personnelles et retrouvez vos dernières commandes en un coup d'œil.</p>
            </div>

            <div class="shop-head-aside">
                <span class="shop-count"><b>@Model.TotalOrders</b> commande(s)</span>
                <a class="shop-outline-btn" asp-controller="Order" asp-action="History">
                    Mes commandes
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </a>
            </div>
        </header>

        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="auth-alert is-success" role="status">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="m5 12 4.2 4.2L19 6.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span>@successMessage</span>
            </div>
        }

        <div class="account-layout">
            <aside class="account-side" aria-label="Résumé du compte">
                <div class="account-card">
                    <div class="account-id">
                        @if (!string.IsNullOrWhiteSpace(Model.ProfilePictureUrl))
                        {
                            <img class="account-avatar account-avatar-image" src="@Model.ProfilePictureUrl" alt="Photo de profil de @fullName" />
                        }
                        else
                        {
                            <span class="account-avatar" aria-hidden="true">@initials</span>
                        }
                        <div class="account-id-copy">
                            <span class="account-name">@fullName</span>
                            <span class="account-email">@Model.Email</span>
                        </div>
                    </div>

                    <span class="account-status">Compte actif</span>

                    <div class="account-stats">
                        <div class="account-stat">
                            <strong>@Model.TotalOrders</strong>
                            <span>Commandes</span>
                        </div>
                        <div class="account-stat">
                            <strong>@Model.RecentOrders.Count</strong>
                            <span>Récentes</span>
                        </div>
                    </div>

                    <nav class="account-nav" aria-label="Navigation du compte">
                        <a asp-controller="Order" asp-action="History">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <path d="M7 3h7l4 4v14H7z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
                                <path d="M14 3v4h4M10 12h5M10 16h5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                            </svg>
                            Mes commandes
                        </a>
                        <a asp-controller="Cart" asp-action="Index">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <path d="M6 8h12l-1 12H7L6 8Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
                                <path d="M9 8V6a3 3 0 0 1 6 0v2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                            </svg>
                            Mon panier
                        </a>
                        <a asp-controller="Product" asp-action="Index">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <rect x="4" y="4" width="7" height="7" rx="1.6" stroke="currentColor" stroke-width="1.8" />
                                <rect x="13" y="4" width="7" height="7" rx="1.6" stroke="currentColor" stroke-width="1.8" />
                                <rect x="4" y="13" width="7" height="7" rx="1.6" stroke="currentColor" stroke-width="1.8" />
                                <rect x="13" y="13" width="7" height="7" rx="1.6" stroke="currentColor" stroke-width="1.8" />
                            </svg>
                            Explorer le catalogue
                        </a>
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button class="account-logout" type="submit">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                    <path d="M15 5H7a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                                    <path d="M14 12h7m-3-3 3 3-3 3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                                Déconnexion
                            </button>
                        </form>
                    </nav>
                </div>
            </aside>

            <div class="account-main">
                <section class="account-form-card" aria-labelledby="profile-form-title">
                    <div class="account-card-head">
                        <div>
                            <h2 class="account-card-title" id="profile-form-title">Informations personnelles</h2>
                            <p class="account-card-sub">Ces informations sont utilisées pour vos commandes et votre livraison.</p>
                        </div>
                    </div>

                    <form class="auth-form account-form" asp-action="Profile" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="auth-validation" role="alert"></div>

                        <div class="account-avatar-field">
                            @if (!string.IsNullOrWhiteSpace(Model.ProfilePictureUrl))
                            {
                                <img class="account-avatar-preview" data-profile-picture-preview
                                     src="@Model.ProfilePictureUrl" alt="Aperçu de la photo de profil" />
                            }
                            else
                            {
                                <img class="account-avatar-preview" data-profile-picture-preview
                                     alt="Aperçu de la photo de profil" hidden />
                            }
                            <div class="account-avatar-control">
                                <label class="auth-label" asp-for="ProfilePicture">
                                    @Html.DisplayNameFor(model => model.ProfilePicture)
                                </label>
                                <input class="account-file-input" asp-for="ProfilePicture" type="file"
                                       accept="image/png,image/jpeg,image/gif,image/webp" data-profile-picture-input />
                                <span class="auth-hint">JPG, PNG, GIF ou WEBP · 2 Mo maximum.</span>
                                <span class="auth-error" asp-validation-for="ProfilePicture"></span>
                            </div>
                        </div>

                        <div class="auth-grid">
                            <div class="auth-field">
                                <label class="auth-label" asp-for="FirstName">
                                    @Html.DisplayNameFor(model => model.FirstName)
                                    <span class="auth-req" aria-hidden="true">*</span>
                                </label>
                                <div class="auth-input">
                                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                        <circle cx="12" cy="8" r="3.6" stroke="currentColor" stroke-width="1.8" />
                                        <path d="M5 20c1.3-3.5 4-5.2 7-5.2s5.7 1.7 7 5.2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                                    </svg>
                                    <input class="auth-control" asp-for="FirstName" autocomplete="given-name" placeholder="Prénom" aria-required="true" />
                                </div>
                                <span class="auth-error" asp-validation-for="FirstName"></span>
                            </div>

                            <div class="auth-field">
                                <label class="auth-label" asp-for="LastName">
                                    @Html.DisplayNameFor(model => model.LastName)
                                    <span class="auth-req" aria-hidden="true">*</span>
                                </label>
                                <div class="auth-input">
                                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                        <circle cx="12" cy="8" r="3.6" stroke="currentColor" stroke-width="1.8" />
                                        <path d="M5 20c1.3-3.5 4-5.2 7-5.2s5.7 1.7 7 5.2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                                    </svg>
                                    <input class="auth-control" asp-for="LastName" autocomplete="family-name" placeholder="Nom" aria-required="true" />
                                </div>
                                <span class="auth-error" asp-validation-for="LastName"></span>
                            </div>
                        </div>

                        <div class="auth-field">
                            <label class="auth-label" asp-for="Email">
                                @Html.DisplayNameFor(model => model.Email)
                            </label>
                            <div class="auth-input is-readonly">
                                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                    <rect x="3.5" y="5.5" width="17" height="13" rx="3" stroke="currentColor" stroke-width="1.8" />
                                    <path d="m4.5 7.5 7.5 5.4 7.5-5.4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                                <input class="auth-control" asp-for="Email" type="email" readonly aria-describedby="email-hint" />
                            </div>
                            <span class="auth-hint" id="email-hint">L'adresse e-mail ne peut pas être modifiée.</span>
                            <span class="auth-error" asp-validation-for="Email"></span>
                        </div>

                        <div class="auth-field">
                            <label class="auth-label" asp-for="PhoneNumber">
                                @Html.DisplayNameFor(model => model.PhoneNumber)
                            </label>
                            <div class="auth-input">
                                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                    <path d="M7.5 3.5h2.2l1.4 3.6-1.7 1.4a12 12 0 0 0 5.1 5.1l1.4-1.7 3.6 1.4v2.2a2 2 0 0 1-2.2 2A15.5 15.5 0 0 1 5.5 5.7a2 2 0 0 1 2-2.2Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
                                </svg>
                                <input class="auth-control" asp-for="PhoneNumber" type="tel" autocomplete="tel" placeholder="+33 6 12 34 56 78" />
                            </div>
                            <span class="auth-error" asp-validation-for="PhoneNumber"></span>
                        </div>

                        <div class="account-actions">
                            <button class="auth-submit" type="submit">
                                Enregistrer les modifications
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                    <path d="m5 12 4.2 4.2L19 6.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                            </button>
                            <a class="account-secondary" asp-controller="Home" asp-action="Index">Annuler</a>
                        </div>
                    </form>
                </section>

                <section class="account-orders" aria-labelledby="account-orders-title">
                    <div class="account-orders-head">
                        <div>
                            <h2 class="account-card-title" id="account-orders-title">Commandes récentes</h2>
                            <p class="account-card-sub">@Model.TotalOrders commande(s) enregistrée(s) sur votre compte.</p>
                        </div>
                        <a class="account-link" asp-controller="Order" asp-action="History">
                            Tout voir
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </a>
                    </div>

                    @if (Model.RecentOrders.Count == 0)
                    {
                        <div class="account-orders-empty">
                            <svg width="34" height="34" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <path d="M7 3h7l4 4v14H7z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
                                <path d="M14 3v4h4M10 12h5M10 16h5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                            </svg>
                            <strong>Aucune commande pour le moment</strong>
                            <p>Votre première commande apparaîtra ici dès qu'elle sera validée.</p>
                            <a class="account-link" asp-controller="Product" asp-action="Index">
                                Découvrir le catalogue
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                    <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="account-order-list">
                            @foreach (var order in Model.RecentOrders)
                            {
                                <a class="account-order" asp-controller="Order" asp-action="Details" asp-route-id="@order.Id"
                                   aria-label="Voir la commande @order.OrderNumber">
                                    <div>
                                        <div class="account-order-num">@order.OrderNumber</div>
                                        <div class="account-order-date">@order.OrderDate.ToLocalTime().ToString("dd/MM/yyyy")</div>
                                    </div>
                                    <span class="account-order-total">@order.TotalAmount.ToString("N2") €</span>
                                    <span class="account-badge">@order.StatusLabel</span>
                                    <span class="account-order-link">
                                        Détails
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                            <path d="m9 6 6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                        </svg>
                                    </span>
                                </a>
                            }
                        </div>

                        @if (Model.TotalOrders > Model.RecentOrders.Count)
                        {
                            <div class="account-orders-foot">
                                <a class="account-link" asp-controller="Order" asp-action="History">
                                    Voir les @Model.TotalOrders commandes
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                        <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                </a>
                            </div>
                        }
                    }
                </section>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
