@model RegisterViewModel
@{
    ViewData["Title"] = "Inscription";
}

<div style="max-width: 600px; margin: 2rem auto; padding: 1rem 1rem 2rem; background: #fff; border: 1px solid #dee2e9; border-radius: 0.375rem;">
    <h1 style="margin-bottom: 1rem;">Créer un compte</h1>

    <form asp-action="Register" method="post" style="max-width: 400px;">
        <div style="margin-bottom: 0.75rem;">
            <label style="display: block; font-size: 0.875rem; margin-bottom: 0.25rem;">Prénom</label>
            <input style="width: 100%; padding: 0.375rem; border: 1px solid #ccc; border-radius: 0.25rem; margin-bottom: 0.5rem;" asp-for="FirstName" />
            <span style="color: #dc3545; font-size: 0.875rem; display: block;" asp-validation-for="FirstName"></span>
        </div>

        <div style="margin-bottom: 0.75rem;">
            <label style="display: block; font-size: 0.875rem; margin-bottom: 0.25rem;">Nom</label>
            <input style="width: 100%; padding: 0.375rem; border: 1px solid #ccc; border-radius: 0.25rem; margin-bottom: 0.5rem;" asp-for="LastName" />
            <span style="color: #dc3545; font-size: 0.875rem; display: block;" asp-validation-for="LastName"></span>
        </div>

        <div style="margin-bottom: 0.75rem;">
            <label style="display: block; font-size: 0.875rem; margin-bottom: 0.25rem;">Email</label>
            <input style="width: 100%; padding: 0.375rem; border: 1px solid #ccc; border-radius: 0.25rem; margin-bottom: 0.5rem;" asp-for="Email" />
            <span style="color: #dc3545; font-size: 0.875rem; display: block;" asp-validation-for="Email"></span>
        </div>

        <div style="margin-bottom: 0.75rem;">
            <label style="display: block; font-size: 0.875rem; margin-bottom: 0.25rem;">Mot de passe</label>
            <input style="width: 100%; padding: 0.375rem; border: 1px solid #ccc; border-radius: 0.25rem; margin-bottom: 0.5rem;" asp-for="Password" />
            <div style="font-size: 0.8125rem; color: #6c7573;">8 caractères minimum, avec majuscule, minuscule et chiffre.</div>
        </div>

        <div style="margin-bottom: 1rem;">
            <label style="display: block; font-size: 0.875rem; margin-bottom: 0.25rem;">Confirmation du mot de passe</label>
            <input style="width: 100%; padding: 0.375rem; border: 1px solid #ccc; border-radius: 0.25rem; margin-bottom: 0.5rem;" asp-for="ConfirmPassword" />
            <span style="color: #dc3545; font-size: 0.875rem; display: block;" asp-validation-for="ConfirmPassword"></span>
        </div>

        <button type="submit" style="width: 100%; padding: 0.5rem; background: #007bff; color: white; border: none; border-radius: 0.25rem; cursor: pointer; font-size: 0.875rem;">S'inscrire</button>

        <p class="mt-2" style="text-align: center; font-size: 0.875rem;">
            Déjà un compte ? <a asp-action="Login" style="color: #007bff; text-decoration: none;">Se connecter</a>
        </p>
    </form>
</div>