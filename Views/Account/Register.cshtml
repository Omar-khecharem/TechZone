@model RegisterViewModel
@{
    ViewData["Title"] = "Créer un compte";
}

<div class="auth-page">
    <div class="tz-container">
        <div class="auth-shell">
            <aside class="auth-aside">
                <span class="auth-eyebrow">Nouveau membre</span>
                <h2 class="auth-aside-title">Rejoignez<br /><em>l'univers TechZone.</em></h2>
                <p class="auth-aside-text">
                    Créez votre compte pour composer votre panier, finaliser vos commandes
                    et retrouver votre historique en un instant.
                </p>

                <ul class="auth-benefits">
                    <li>
                        <span class="auth-benefit-icon" aria-hidden="true">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none">
                                <circle cx="12" cy="8" r="3.6" stroke="currentColor" stroke-width="1.8" />
                                <path d="M5 20c1.3-3.5 4-5.2 7-5.2s5.7 1.7 7 5.2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                            </svg>
                        </span>
                        <div class="auth-benefit-copy">
                            <strong>Inscription en une minute</strong>
                            <span>Quelques informations suffisent pour commencer.</span>
                        </div>
                    </li>
                    <li>
                        <span class="auth-benefit-icon" aria-hidden="true">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none">
                                <path d="M12 3.5 5 6.5v5.2c0 4.2 2.9 7.4 7 8.8 4.1-1.4 7-4.6 7-8.8V6.5l-7-3Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
                                <path d="m9 12 2 2 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </span>
                        <div class="auth-benefit-copy">
                            <strong>Données protégées</strong>
                            <span>Vos informations personnelles restent confidentielles.</span>
                        </div>
                    </li>
                    <li>
                        <span class="auth-benefit-icon" aria-hidden="true">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none">
                                <path d="M7 3h7l4 4v14H7z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
                                <path d="M14 3v4h4M10 12h5M10 16h5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                            </svg>
                        </span>
                        <div class="auth-benefit-copy">
                            <strong>Commandes centralisées</strong>
                            <span>Retrouvez chaque achat et son statut au même endroit.</span>
                        </div>
                    </li>
                </ul>

                <div class="auth-aside-foot">TechZone · La technologie, bien choisie.</div>
            </aside>

            <section class="auth-card" aria-labelledby="register-title">
                <header class="auth-head">
                    <span class="auth-kicker">Inscription</span>
                    <h1 class="auth-title" id="register-title">Créons votre compte.</h1>
                    <p class="auth-subtitle">Profitez d'une expérience d'achat simple et personnalisée.</p>
                </header>

                <form class="auth-form" asp-action="Register" method="post">
                    <div asp-validation-summary="ModelOnly" class="auth-validation" role="alert"></div>

                    <div class="auth-grid">
                        <div class="auth-field">
                            <label class="auth-label" asp-for="FirstName">
                                @Html.DisplayNameFor(model => model.FirstName)
                                <span class="auth-req" aria-hidden="true">*</span>
                            </label>
                            <div class="auth-input">
                                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                    <circle cx="12" cy="8" r="3.6" stroke="currentColor" stroke-width="1.8" />
                                    <path d="M5 20c1.3-3.5 4-5.2 7-5.2s5.7 1.7 7 5.2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                                </svg>
                                <input class="auth-control" asp-for="FirstName" autocomplete="given-name"
                                       placeholder="Prénom" aria-required="true" />
                            </div>
                            <span class="auth-error" asp-validation-for="FirstName"></span>
                        </div>

                        <div class="auth-field">
                            <label class="auth-label" asp-for="LastName">
                                @Html.DisplayNameFor(model => model.LastName)
                                <span class="auth-req" aria-hidden="true">*</span>
                            </label>
                            <div class="auth-input">
                                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                    <circle cx="12" cy="8" r="3.6" stroke="currentColor" stroke-width="1.8" />
                                    <path d="M5 20c1.3-3.5 4-5.2 7-5.2s5.7 1.7 7 5.2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                                </svg>
                                <input class="auth-control" asp-for="LastName" autocomplete="family-name"
                                       placeholder="Nom" aria-required="true" />
                            </div>
                            <span class="auth-error" asp-validation-for="LastName"></span>
                        </div>
                    </div>

                    <div class="auth-field">
                        <label class="auth-label" asp-for="Email">
                            @Html.DisplayNameFor(model => model.Email)
                            <span class="auth-req" aria-hidden="true">*</span>
                        </label>
                        <div class="auth-input">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <rect x="3.5" y="5.5" width="17" height="13" rx="3" stroke="currentColor" stroke-width="1.8" />
                                <path d="m4.5 7.5 7.5 5.4 7.5-5.4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                            <input class="auth-control" asp-for="Email" type="email" autocomplete="email"
                                   placeholder="vous@exemple.com" aria-required="true" />
                        </div>
                        <span class="auth-error" asp-validation-for="Email"></span>
                    </div>

                    <div class="auth-grid">
                        <div class="auth-field">
                            <label class="auth-label" asp-for="Password">
                                @Html.DisplayNameFor(model => model.Password)
                                <span class="auth-req" aria-hidden="true">*</span>
                            </label>
                            <div class="auth-input">
                                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                    <rect x="5" y="10.5" width="14" height="9.5" rx="2.6" stroke="currentColor" stroke-width="1.8" />
                                    <path d="M8.5 10.5V8a3.5 3.5 0 0 1 7 0v2.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                                </svg>
                                <input class="auth-control" asp-for="Password" autocomplete="new-password"
                                       placeholder="Mot de passe" aria-required="true" aria-describedby="password-hint" />
                                <button class="auth-reveal" type="button" data-password-toggle
                                        aria-controls="Password" aria-pressed="false" aria-label="Afficher le mot de passe">
                                    <svg class="auth-eye" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                        <path d="M2.8 12S6 5.8 12 5.8 21.2 12 21.2 12 18 18.2 12 18.2 2.8 12 2.8 12Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
                                        <circle cx="12" cy="12" r="2.6" stroke="currentColor" stroke-width="1.8" />
                                    </svg>
                                    <svg class="auth-eye-off" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                        <path d="M4 4l16 16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                                        <path d="M9.8 6.2A9.7 9.7 0 0 1 12 5.8c6 0 9.2 6.2 9.2 6.2a16 16 0 0 1-2.7 3.5M6.2 8.3A16.2 16.2 0 0 0 2.8 12S6 18.2 12 18.2c1 0 1.9-.2 2.7-.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                                        <path d="M10.1 10.1a2.6 2.6 0 0 0 3.7 3.7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                                    </svg>
                                </button>
                            </div>
                            <span class="auth-hint" id="password-hint">8 caractères minimum, avec majuscule, minuscule et chiffre.</span>
                            <span class="auth-error" asp-validation-for="Password"></span>
                        </div>

                        <div class="auth-field">
                            <label class="auth-label" asp-for="ConfirmPassword">
                                @Html.DisplayNameFor(model => model.ConfirmPassword)
                                <span class="auth-req" aria-hidden="true">*</span>
                            </label>
                            <div class="auth-input">
                                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                    <rect x="5" y="10.5" width="14" height="9.5" rx="2.6" stroke="currentColor" stroke-width="1.8" />
                                    <path d="M8.5 10.5V8a3.5 3.5 0 0 1 7 0v2.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                                </svg>
                                <input class="auth-control" asp-for="ConfirmPassword" autocomplete="new-password"
                                       placeholder="Confirmer le mot de passe" aria-required="true" />
                                <button class="auth-reveal" type="button" data-password-toggle
                                        aria-controls="ConfirmPassword" aria-pressed="false" aria-label="Afficher le mot de passe">
                                    <svg class="auth-eye" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                        <path d="M2.8 12S6 5.8 12 5.8 21.2 12 21.2 12 18 18.2 12 18.2 2.8 12 2.8 12Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
                                        <circle cx="12" cy="12" r="2.6" stroke="currentColor" stroke-width="1.8" />
                                    </svg>
                                    <svg class="auth-eye-off" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                        <path d="M4 4l16 16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                                        <path d="M9.8 6.2A9.7 9.7 0 0 1 12 5.8c6 0 9.2 6.2 9.2 6.2a16 16 0 0 1-2.7 3.5M6.2 8.3A16.2 16.2 0 0 0 2.8 12S6 18.2 12 18.2c1 0 1.9-.2 2.7-.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                                        <path d="M10.1 10.1a2.6 2.6 0 0 0 3.7 3.7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                                    </svg>
                                </button>
                            </div>
                            <span class="auth-error" asp-validation-for="ConfirmPassword"></span>
                        </div>
                    </div>

                    <button class="auth-submit" type="submit">
                        Créer mon compte
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </button>

                    <p class="auth-switch">
                        Déjà un compte ?
                        <a asp-action="Login">Se connecter</a>
                    </p>
                </form>

                <p class="auth-legal">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <rect x="5" y="10.5" width="14" height="9.5" rx="2.6" stroke="currentColor" stroke-width="2" />
                        <path d="M8.5 10.5V8a3.5 3.5 0 0 1 7 0v2.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                    </svg>
                    Inscription sécurisée · Aucune donnée revendue.
                </p>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
