@{
    ViewData["Title"] = "Accès refusé";
}

<div class="auth-page">
    <div class="tz-container">
        <div class="auth-shell" style="grid-template-columns: minmax(0, 1fr); max-width: 560px; margin: 0 auto;">
            <section class="auth-card" aria-labelledby="access-denied-title">
                <header class="auth-head">
                    <span class="auth-kicker">Accès restreint</span>
                    <h1 class="auth-title" id="access-denied-title">Accès refusé</h1>
                    <p class="auth-subtitle">
                        Vous n'avez pas les droits nécessaires pour accéder à cette section.
                    </p>
                </header>

                <a class="auth-submit" asp-controller="Home" asp-action="Index">
                    Retour à l'accueil
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </a>
            </section>
        </div>
    </div>
</div>
